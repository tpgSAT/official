ErrorDocument 404 /404.html
RewriteEngine On

# 短縮リンク
RewriteRule ^r/instagram/?$ https://www.instagram.com/taki_plaza_gardener/ [R=301,L]

# たきぷら農園301リダイレクト
Redirect 301 /whatsnew/20251007_takipurasityu-/ /whatsnew/20251014_takipuranouen/

# Astro移行に伴うURL変更のリダイレクト

# kyumenmaruti → signage-application にリダイレクト
RedirectMatch 301 ^/kyumenmaruti(/index\.html)?/?$ /signage-application/

# keijibutu → poster-application にリダイレクト
RedirectMatch 301 ^/keijibutu(/index\.html)?/?$ /poster-application/

# aboutus/* → about にリダイレクト
RedirectMatch 301 ^/aboutus(/.*)?$ /about/

# whatsnew → events にリダイレクト
RedirectMatch 301 ^/whatsnew(/index\.html)?/?$ /events/

# /whatsnew/20250624_stainedglass → /events/2025/stainedglass にリダイレクト
RedirectMatch 301 ^/whatsnew/20250624_stainedglass(/index\.html)?/?$ /events/2025/stainedglass/

# /whatsnew/20250621_takimatsuri → /events/2025/takimatsuri にリダイレクト
RedirectMatch 301 ^/whatsnew/20250621_takimatsuri(/index\.html)?/?$ /events/2025/takimatsuri/

# /whatsnew/20251014_takipuranouen → /events/2025/takipura-farm にリダイレクト
RedirectMatch 301 ^/whatsnew/20251014_takipuranouen(/index\.html)?/?$ /events/2025/takipura-farm/

# /whatsnew/20251014_koudaisai → /events/2025/tpg-cafe にリダイレクト
RedirectMatch 301 ^/whatsnew/20251014_koudaisai(/index\.html)?/?$ /events/2025/tpg-cafe/