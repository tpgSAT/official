---
import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

import { Image } from 'astro:assets';
import Blobs from '@assets/generic/blobs.png';

interface Props {
	title: string;
	description?: string;
}
const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
    <Breadcrumb lists={[{ path: 'about', name: title }]} />
    <div id="heading">
        <h1>{title}</h1>
        <p>{description}</p>
    </div>
    <!-- 背景装飾用のBlobs -->
    <Image src={Blobs} id="blobs" alt="Blobs" />
    <slot />
</Layout>


<style>
    #heading {
        padding: 20px 5vw;
    }

    #heading h1 {
        font-family: 'Midashi Go MB31', 'Noto Sans JP Variable', sans-serif;
        font-size: 28px;
        letter-spacing: 2px;
        font-weight: 500;
    }

    #heading p {
        font-family: 'Noto Sans JP Variable', sans-serif;
        font-weight: 500;
		font-size: 12px;
		letter-spacing: 0.8px;
        line-height: 200%;
		color: #000;
        margin: 30px 0;
    }

    #blobs {
        position: absolute;
		top: 120px;
		left: -120px;
		width: 80vw;
		height: auto;
		z-index: -1;
    }
</style>