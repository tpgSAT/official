---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const defaultDescription = 'Taki Plaza Gardener(通称TPG)は東京科学大学(旧東京工業大学)の新たなランドマーク「Taki Plaza」で活動する学生団体です。';

const { title, description = defaultDescription }:Props= Astro.props;

// Google FontsのNoto Sans JPを利用
import '@fontsource-variable/noto-sans-jp';

// たきぷら農園用にM PLUS Rounded 1cも利用
import '@fontsource/m-plus-rounded-1c';
---
<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} - Taki Plaza Gardener</title>
		<meta name="description" content={description} />

		<!-- SakuraのWebフォント利用 -->
		<script type="text/javascript" src="//webfonts.sakura.ne.jp/js/sakurav3.js"></script>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100vw;
		overflow-x: hidden;
		position: relative;
	}

	body {
		padding-top: 80px; /* ヘッダーの高さ分の余白を確保 */
	}

	a {
		text-decoration: none;
		color: inherit;
	}
</style>