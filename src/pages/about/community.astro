---
import { Image } from 'astro:assets';

import GenericLayout from '@layouts/GenericLayout.astro';
import Heading from '@components/Heading.astro';

import Takimatsuri1 from '@assets/about/event/takimatsuri_1.jpeg';
import Takimatsuri2 from '@assets/about/event/takimatsuri_2.jpg';
import Wakabasai1 from '@assets/about/event/wakabasai_1.jpg';
import Wakabasai2 from '@assets/about/event/wakabasai_2.jpg';
import AsobiImg1 from '@assets/about/production/asobi_1.jpg';
import AsobiImg2 from '@assets/about/production/asobi_2.jpg';
import AsobiImg3 from '@assets/about/production/asobi_3.jpg';

const title = "コミュニティ班";
const description = "TPGを構成する5つの班のうちの1つ、コミュニティ班を紹介します。コミュニティ班はTaki Plazaで様々なコミュニティを形成することを目標にイベントの企画を行っています。企画の内容は様々で、色々なことに挑戦しています。";
---
<GenericLayout title={title} description={description} ListItem={[{ name: 'TPGについて', path: 'about' }, { name: 'コミュニティ班', path: 'community' }]}>
    <Heading title="活動内容">
        コミュニティ班とは人と人のつながりを作るきっかけを提供する班で、学生が他の誰かと会い、新たなコミュニティをつくれるようなワークショップやイベントを企画しています。
        <br />
        例えば、昨年度の2Qには留学生と日本人学生が交流できる国際交流イベントとして和菓子作りイベント「夏の和菓子教室」を開催しました。夏にぴったりの「水無月」と「琥珀糖」を選んで作ってもらい、多くの学生に参加してもらうことができました。
        <br />
        また、今年度の新歓期に新入生同士の親睦を深めコミュニティ形成を促す目的で「新入生交流会」を開催しました。2日間で300人以上の新入生が参加し、様々なゲームやアクティビティを通して交流を深めてもらいました。
        <Image src={Takimatsuri1} alt="滝祭" class="inline-img" />
        <Image src={Takimatsuri2} alt="滝祭" class="inline-img" />
        <Image src={Wakabasai1} alt="若葉祭" class="inline-img" />
        <Image src={Wakabasai2} alt="若葉祭" class="inline-img" />
    </Heading>
    <Heading title="遊び">
        制作班では、活動の合間にみんなで集まって遊ぶこともあります。ピクニックをしたり、ゲームをしたり、たこ焼きを作ったり。こうした時間を通じて、お互いの仲を深めながら、より楽しく活動しています。
        <Image src={AsobiImg1} alt="遊び画像1" class="inline-img" />
        <Image src={AsobiImg2} alt="遊び画像2" class="inline-img" />
        <Image src={AsobiImg3} alt="遊び画像3" class="inline-img" />
    </Heading>
</GenericLayout>

<style>
    .inline-img {
        width: 100%;
        max-height: 100%;
        height: auto;
        margin: 20px 0 0;
        border-radius: 10px;
    }
</style>