---
import GenericLayout from '@layouts/GenericLayout.astro';
import Heading from '@components/Heading.astro';

const title = "TPGについて";
const description = "Taki Plaza Gardener(以下TPG)は、東京科学大学に存在する国際交流と学⽣⽀援を⽬的とする施設であるHisao & Hiroko Taki Plazaでの、学⽣による活発な利⽤を促すことを⽬的として活動しています。";
---
<GenericLayout title={title} description={description}>
    <Heading title="活動内容">
        76名(2025.07現在)のメンバーが所属し、イベント班・コミュニティ班・制作班・マネジメント班・システム班の5つの班に分かれて活動しています。学士3年生以下の東京科学大学生で構成されており、留学生も所属しています。 活動は週1で、活動拠点となるTakiPlaza地下2階の居室では日頃から誰かしらが居てにぎやかに過ごしています。 
    </Heading>
    
</GenericLayout>