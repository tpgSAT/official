---
import { Image } from 'astro:assets';

import GenericLayout from '@layouts/GenericLayout.astro';
import Heading from '@components/Heading.astro';

import Takimatsuri1 from '@assets/about/event/takimatsuri_1.jpeg';
import Takimatsuri2 from '@assets/about/event/takimatsuri_2.jpg';
import Wakabasai1 from '@assets/about/event/wakabasai_1.jpg';
import Wakabasai2 from '@assets/about/event/wakabasai_2.jpg';

const title = "イベント班";
const description = "TPGを構成する5つの班のうちの1つ、イベント班を紹介します。イベント班はTaki Plaza内で行われるイベントの企画・運営を行っています。TPGが実施する企画の中でも大規模なものを行っており、TPGの根幹かつ花形の班です。";
---
<GenericLayout title={title} description={description} ListItem={[{ name: 'TPGについて', path: 'about' }, { name: 'イベント班', path: 'event' }]}>
    <Heading title="活動内容">
        Taki Plazaで行うイベントのアイデア出しから準備、当日の運営までをすべて自分たちで行います。
        イベントの内容によっては大学内の様々なサークルや団体と連携することもあるので、コミュニケーション能力も身につきます。
        今年度は昨年度に引き続き若葉祭（新歓イベント）、滝祭（日本の祭文化をテーマにした国際交流イベント）、工大祭へのボードゲームカフェの出店などを行いました。
        それぞれのイベントの詳細は直近のイベントにありますので、興味のある方はぜひ確認してみてくださいね！！
        <Image src={Takimatsuri1} alt="滝祭" class="inline-img" />
        <Image src={Takimatsuri2} alt="滝祭" class="inline-img" />
        <Image src={Wakabasai1} alt="若葉祭" class="inline-img" />
        <Image src={Wakabasai2} alt="若葉祭" class="inline-img" />
    </Heading>
    <Heading title="遊び">
        イベ班自体の遊び自体は多くはありませんが、みんなで行く遊びは楽しいですよ！
    </Heading>
</GenericLayout>

<style>
    .inline-img {
        width: 100%;
        max-height: 100%;
        height: auto;
        margin: 20px 0 0;
        border-radius: 10px;
    }
</style>