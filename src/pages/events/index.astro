---
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { Image } from "astro:assets";

import { events } from "@lib/events";

const ListItem = [{ path: "events", name: "過去のイベント" }];
---

<Layout title="過去のイベント">
  <Breadcrumb lists={ListItem} />
  <div id="root">
    <h1>過去のイベント</h1>
    {
      events.map((event) => (
        <a href={`/events${event.path}`}>
            <div class="blog-content">
                <div class="img-wrapper"><Image src={event.thumbnail} class="blog-thumbnail" alt={event.title} /></div>
                <p class="blog-date">{new Date(event.date).toLocaleDateString('ja-JP')}</p>
                <h3 class="blog-title">{event.title}</h3>
                <p class="description">{event.description}</p>
            </div>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  #root {
    margin: 0 5vw 40px;
  }

  #root h1 {
    font-family: "Midashi Go MB31", "Noto Sans JP Variable", sans-serif;
    font-size: 28px;
    letter-spacing: 2px;
    font-weight: 500;
  }

  .blog-content {
    font-family: 'Noto Sans JP Variable', sans-serif;
		padding: 0;
    margin: 20px 0;
		display: grid;
		grid-template-columns: 40% 1fr;
		grid-template-rows: 15px 25px 50px;
		gap: 0 10px;
	}

  .img-wrapper {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

	.blog-thumbnail {
		width: 100%;
    height: 100%;
    object-fit: cover;
		border-radius: 10px;
		grid-column: 1 / 2;
		grid-row: 1 / 4;
	}

	.blog-date, .description {
		letter-spacing: 0.4px;
		margin: 0;
		display: inline-block;
		grid-column: 2 / 3;
	}

	.blog-title {
		font-weight: 500;
		font-size: 14px;
		margin: 0;
		padding: 0;
		grid-column: 2 / 3;
		grid-row: 2 / 3;
	}

	.blog-date {
		font-weight: 400;
		font-size: 10px;
		color: #030303;
		grid-row: 1 / 2;
	}

  .description {
		font-weight: 400;
		font-size: 10px;
		color: #707070;
    grid-row: 3 / 4;
  }
</style>
