---

import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";

const ListItem = [{ path: "events", name: "過去のイベント" }];

const modules = import.meta.glob('./**/*.astro', { eager: true });

// 各ページの情報を整形
const events = Object.entries(modules).map(([path, mod]) => {
  const url = path
    .replace('./', '/events/')
    .replace(/\.astro$/, '');
  return {
    title: mod.frontmatter?.title ?? '無題のイベント',
    date: mod.frontmatter?.date ?? null,
    url,
  };
}).sort((a, b) => (b.date || '').localeCompare(a.date || ''));

---

<Layout title="過去のイベント">
  <Breadcrumb lists={ListItem} />
  <div id="root">
    <h1>過去のイベント</h1>
    <ul>
      {events.map(event => (
        <li>
          <a href={event.url}>{event.title}</a>
          {event.date && <span>（{event.date}）</span>}
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  #root {
    margin: 0 5vw 40px;
  }

  #root h1 {
    font-family: "Midashi Go MB31", "Noto Sans JP Variable", sans-serif;
    font-size: 28px;
    letter-spacing: 2px;
    font-weight: 500;
  }

  .blog-content {
    font-family: "Noto Sans JP Variable", sans-serif;
    padding: 15px 0 0;
    display: grid;
    grid-template-columns: 40% 1fr;
    grid-template-rows: 20px 1fr 20px;
    gap: 0 10px;
  }

  .blog-thumbnail {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 10px;
    grid-column: 1 / 2;
    grid-row: 1 / 4;
  }

  .blog-tags,
  .blog-date {
    font-weight: 400;
    font-size: 10px;
    letter-spacing: 0.4px;
    color: #707070;
    margin: 0;
    display: inline-block;
    grid-column: 2 / 3;
  }

  .blog-title {
    font-weight: 500;
    font-size: 14px;
    margin: 0;
    padding: 0;
    grid-column: 2 / 3;
    grid-row: 2 / 3;
  }

  .blog-tags {
    grid-row: 1 / 2;
  }

  .blog-tag {
    padding: 0;
    margin: 0;
  }

  .blog-date {
    grid-row: 3 / 4;
  }
</style>
