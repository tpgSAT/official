---
import Layout from "@layouts/Layout.astro";

import backgroundImg from "@assets/events/2025/freshman-meetup/background.jpeg";

import past_event1 from "@assets/events/2025/freshman-meetup/past_event1.jpg"

import past_event2 from "@assets/events/2025/freshman-meetup/past_event2.jpg"

import past_event3 from "@assets/events/2025/freshman-meetup/past_event3.jpg"

import Sakura from "@components/Effects/Sakura.astro";

import FadeIn from "@components/Effects/FadeIn.astro";

import HorizontalGallery from "@components/HorizontalGallery.astro";

const title = "新入生交流会";
const description =
  "TPGでは、健康診断の2, 3日目に、Taki Plaza B2Fでボードゲームを通して新入生が自由に交流できるイベントを開催します。";
const past_event_gallery = [
    { src: past_event1, alt:"過去のイベントの様子"},
    { src: past_event2, alt:"過去のイベントの様子"},
    { src: past_event3, alt:"過去のイベントの様子"},
];
---

<Layout title={title} description={description}>
    <Sakura />
    <div class="content" style={`background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url(${backgroundImg.src});`}>
        <p class="ST">SCIENCE TOKYO</p>
        <p class="contentTitle">新入生交流会</p>
        <p class="contentText text-body">健康診断の日にTaki Plazaで新入生と交流を深めよう！</p>
        <div class="contentDatePlace">
            <p class="contentDate">3/30(月), 31(火) 10:00~17:00</p>
            <p class="contentPlace">Taki Plaza B2F イベントスペース</p>
        </div>
    </div>
    <FadeIn>
        <section id="about_event">
            <h2>新入生交流会とは</h2>
            <HorizontalGallery images={past_event_gallery} />
            <div class="slider-dots" id="slider-dots"></div>
            <p>
                健康診断の2, 3日目に、ボードゲームを通じて新入生が自由に交流できるイベントを開催します。
                会場には様々なボードゲームを準備しているので、初心者の方でも安心して楽しめます。
                <br>昨年度は150名以上の方が参加してくれました！
                途中参加・途中退出は自由で、当日の飛び入り参加も可能です。
                <br>参加費は<b>無料</b>ですので、ぜひ気軽にお越しください！
            </p>
        </section>
    </FadeIn>
    <FadeIn>
        <section id="about_tpg">
            <h2>TPGについて</h2>
            <p>
                Taki Plaza Gardener(通称TPG)は、国際交流と学生支援を目的とする大岡山キャンパスの施設Hisao & Hiroko Taki Plaza で活動している公認学生団体です。<br/>
                TPGは本イベントをはじめ、学生がTaki Plazaをもっと身近に、もっと活発に利用できるよう、年間を通してさまざまな学生向けイベントを企画・運営しています。<br/>
                少しでもTPGに興味を持った方は、ぜひTaki Plaza 地下2階の居室へお越しください！
            </p>
            <a href="/shinkan" class="to_tpg_hp">詳しくはこちらをチェック！</a>
        </section>
    </FadeIn>
</Layout>

<style>
    html {
        scroll-behavior: smooth;
        padding: 0;
    }

    .text-body{
        font-family: "Noto Sans JP Variable", sans-serif;
        font-size: clamp(11px, 1.8vw, 16px);
        font-style: normal;
        font-weight: 400;
        line-height: 220%;
        letter-spacing: 1.2px;
    }

    /* ── Hero ── */
    .content {
        height: 70vh;
        width: 100%;
        min-height: 56vw; /* approx 16/9 on mobile */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        margin: 0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding: 8% 5% 6%;
        box-sizing: border-box;
    }
    .ST {
        width: 100%;
        text-align: center;
        font-size: clamp(24px, 4vw, 60px);
        font-weight: 900;
        color: white;
        margin: 0 0 0.2em;
    }
    .contentTitle {
        width: 100%;
        text-align: center;
        letter-spacing: 0.3rem;
        font-size: clamp(30px, 5vw, 75px);
        font-weight: 800;
        color: white;
        margin: 0 0 0;
    }
    .contentText {
        font-weight: bold;
        padding: 0 10px;
        margin: 0.5em auto 1em;
        text-align: center;
        font-size: clamp(10px, 2.5vw, 30px);
        color: white;
        background-color: #20202070;
        border-radius: 8px;
        box-shadow: 3px 5px 5px rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(2px);
    }
    .contentDatePlace {
        font-weight: bold;
        text-align: left;
        padding: 0 5px;
        margin-top: 0.5em;
        background-color: #808080a0;
        border-radius: 8px;
        box-shadow: 3px 5px 5px rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(2px);
    }

    .contentDate {
        text-align: center;
        font-size: clamp(20px, 2.5vw, 50px);
        color: white;
        line-height: 1.8;
        margin: 0;
    }

    .contentPlace {
        text-align: center;
        font-size: clamp(20px, 2.5vw, 50px);
        color: white;
        line-height: 1.8;
        margin: 0;
    }

    section {
        max-width: 900px;
        margin: 60px auto;
        background-color: white;
        padding: 30px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1); /* 軽い影で浮き上がらせる */
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
        color: #91bbfe;
        border-bottom: 2px dashed #91bbfe;
        padding-bottom: 10px;
    }

    #about_event h2 {
        color: #3E6FB8;
        border-bottom: 2px dashed #91bbfe;
    }

    #about_tpg {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    #about_tpg h2 {
        color: #55d26c;
        border-bottom: 2px dashed #87F99B;
    }

    .to_tpg_hp {
        text-decoration: none;
        font-weight: bold;
        margin-top: 2em;
        color: #000000;
        background-color: #87F99B;
        padding: 10px 15px;
        border: 0.1px solid #87F99B;
        border-radius: 20px;
        box-shadow: 0 0.2vh 0 1px #4b8a56;
        transition: all 0.3s ease;
    }

    .to_tpg_hp:hover {
        /* 垂直方向の影を3pxに縮める */
        box-shadow: 0 3px 0 #34603b;
        /* ボタンを少し下に下げる */
        transform: translateY(3px);
    }

    .to_tpg_hp:active {
        transform: translateY(3px);      /* 3px下に下げる */
        box-shadow: 0 3px 0 #34603b;    /* 影を薄くして押し込んだ感を出す */
    }

    @media screen and (min-width: 1024px) {
        .content {
            min-height: 0;
            aspect-ratio: 16 / 9;
            padding: 0;
            justify-content: center;
        }
        .ST {
            padding-top: 0;
            margin-bottom: 0.1em;
        }
    }

    /* ── Small mobile (<480px) ── */
    @media screen and (max-width: 670px) {
        .content {
            min-height: 0;
            aspect-ratio: unset;
            padding: 12% 5% 10%;
        }
        .contentTitle {
            letter-spacing: 0.15rem;
        }
        .contentText {
            margin: 1em 0;
        }
        .contentDatePlace {
            margin-top: 2em;
        }
    }
</style>