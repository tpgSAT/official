---
import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import backgroundImg from "@assets/events/2025/freshman-meetup/background.jpeg";

const title = "新入生交流会";
const description =
  "TPGでは、健康診断の2, 3日目に、Taki Plaza B2Fでボードゲームを通して新入生が自由に交流できるイベントを開催します。";
---

<Layout title={title} description={description}>
    <div class="content" style={`background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url(${backgroundImg.src});`}>
        <p class="ST">SCIENCE TOKYO</p>
        <p class="contentTitle">新入生交流会</p>
        <p class="contentText text-body">健康診断の日にTaki Plazaで交流を深めませんか？</p>
        <p class="contentDate">3/30, 31 10:00~17:00<br/>in Taki Plaza B2F イベントスペース</p>
    </div>
    <div class="about">
        <h4 class="aboutTitle">ABOUT</h4>
        <p class="aboutText text-body">
            昨年度に引き続き、健康診断の2, 3日目に、ボードゲームを通じて新入生が自由に交流できるイベントを開催します！
            会場には様々なボードゲームを用意しており、初心者の方でも安心して楽しめます。
            途中参加・途中退出は自由で、当日の飛び入り参加も可能です。<br/>
            参加費は無料ですので、ぜひ気軽にお越しください！
        </p>
    </div>
    <div class="about_tpg">
        <h4 class="about_tpg_Title">ABOUT TPG</h4>
        <p class="about_tpg_Text text-body">Taki Plaza Gardener(TPG)は、東京科学大学にあるHisao & Hiroko Taki Plazaにおいて、国際交流と学生支援の促進を目的に活動している公認学生団体です。<br/>
            TPGは、本イベントをはじめ、学生がTaki Plazaをもっと身近に、もっと活発に利用できるよう、年間を通してさまざまな学生向けイベントを企画・運営しています。<br/>
            少しでもTPGに興味を持った方は、ぜひTaki Plaza 地下2階の居室へお越しください！
        </p>
        <a href="/shinkan" class="tpg_tag">詳しくはこちらから！</a>
    </div>
</Layout>

<style>
    html {
        scroll-behavior: smooth;
        padding: 0;
    }

    .text-body{
        font-family: "Noto Sans JP Variable", sans-serif;
        font-size: clamp(11px, 1.8vw, 16px);
        font-style: normal;
        font-weight: 400;
        line-height: 220%;
        letter-spacing: 1.2px;
    }

    /* ── Hero ── */
    .content {
        width: 100%;
        min-height: 56vw; /* approx 16/9 on mobile */
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin: 0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding: 8% 5% 6%;
        box-sizing: border-box;
    }
    .ST {
        width: 100%;
        text-align: center;
        font-size: clamp(22px, 4vw, 60px);
        font-weight: 900;
        color: white;
        margin: 0 0 0.2em;
    }
    .contentTitle {
        width: 100%;
        text-align: center;
        letter-spacing: 0.3rem;
        font-size: clamp(26px, 5vw, 75px);
        font-weight: 800;
        color: white;
        margin: 0 0 0.4em;
    }
    .contentText {
        width: 90%;
        margin: 0 auto 0.6em;
        text-align: center;
        color: white;
    }
    .contentDate {
        width: 100%;
        text-align: center;
        font-size: clamp(14px, 2vw, 30px);
        color: white;
        line-height: 1.8;
        margin: 0;
    }

    /* ── About ── */
    .about {
        width: 100%;
        background-color: #91bbfe;
        padding: 5% 5% 6%;
        box-sizing: border-box;
    }
    .aboutTitle {
        text-align: center;
        font-size: clamp(24px, 4vw, 60px);
        font-weight: 900;
        color: white;
        margin: 0 auto 0.8em;
    }
    .aboutText {
        width: min(90%, 900px);
        margin: 0 auto;
        display: block;
        text-align: left;
        color: white;
    }

    /* ── About TPG ── */
    .about_tpg {
        width: 100%;
        background-color: #3E6FB8;
        padding: 5% 5% 6%;
        box-sizing: border-box;
    }
    .about_tpg_Title {
        text-align: center;
        font-size: clamp(24px, 4vw, 60px);
        font-weight: 900;
        color: white;
        margin: 0 auto 0.8em;
    }
    .about_tpg_Text {
        width: min(90%, 900px);
        margin: 0 auto;
        display: block;
        text-align: left;
        color: white;
    }
    .tpg_tag {
        display: block;
        text-align: center;
        margin: 1.5em auto 0;
        font-size: clamp(14px, 1.2vw, 18px);
        font-weight: 400;
        color: white;
        text-decoration: underline;
    }

    /* ── Desktop tweaks (≥1024px) ── */
    @media screen and (min-width: 1024px) {
        .content {
            min-height: 0;
            aspect-ratio: 16 / 9;
            padding: 0;
            justify-content: center;
        }
        .ST {
            padding-top: 0;
            margin-bottom: 0.1em;
        }
        .aboutTitle,
        .about_tpg_Title {
            margin-bottom: 1.2em;
        }
        .aboutText,
        .about_tpg_Text {
            letter-spacing: 0.3em;
        }
        .tpg_tag {
            margin-top: 1.2em;
        }
    }

    /* ── Small mobile (<480px) ── */
    @media screen and (max-width: 480px) {
        .content {
            min-height: 0;
            aspect-ratio: unset;
            padding: 12% 5% 10%;
        }
        .contentTitle {
            letter-spacing: 0.15rem;
        }
        .aboutText,
        .about_tpg_Text {
            width: 95%;
            letter-spacing: 0.04em;
        }
    }
</style>