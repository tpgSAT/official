---
import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import backgroundImg from "@assets/events/2025/freshman-meetup/background.jpeg";

const title = "新入生交流会";
const description =
  "TPGでは、ボードゲームを通して新入生が自由に交流できるイベントを開催します。";
---

<Layout title={title} description={description}>
    <div class="content" style={`background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url(${backgroundImg.src});`}>
        <p class="ST">SCIENCE TOKYO</p>
        <p class="contentTitle">新入生交流会</p>
        <p class="contentText">健康診断の日にTaki Plazaで交流を深めませんか？</p>
        <p class="contentDate">3/30,31 10:00~17:00<br/>in Taki Plaza B2F イベントスペース</p>
    </div>
    <div class="about">
        <h4 class="aboutTitle">ABOUT</h4>
        <p class="aboutText">
            健康診断の2, 3日目に、ボードゲームを通じて新入生が自由に交流できるイベントを開催します。<br/>
            会場には様々なボードゲームを用意しており、初心者の方でも安心して楽しめます。<br/>
            途中参加・途中退出は自由で、当日の飛び入り参加も可能です。<br/>
            昨年度は150名以上もの参加がありました。<br/>
            参加費は無料ですので、ぜひ気軽にお越しください。
        </p>
    </div>
    <div class="about_tpg">
        <h4 class="about_tpg_Title">ABOUT TPG</h4>
        <p class="about_tpg_Text">Taki Plaza Gardener(TPG)は、東京科学大学にあるHisao & Hiroko Taki Plazaにおいて、国際交流と学生支援の促進を目的に活動している公認学生団体です。<br/>
            TPGは、本イベントをはじめ、学生がTaki Plazaをもっと身近に、もっと活発に利用できるよう、年間を通してさまざまな学生向けイベントを企画・運営しています。<br/>
            少しでもTPGに興味を持った方は、ぜひTaki Plaza 地下2階の居室へお越しください！<br/>
            皆さんの参加をお待ちしています。<br/>
        </p>
        <a href=https://tpgd.jp/shinkan/ class="tpg_tag">詳しくはこちらから！</a>
    </div>
</Layout>

