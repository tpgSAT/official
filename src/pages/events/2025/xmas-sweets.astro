---
import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import CristmasSweetsTitleImg from "@assets/events/2025/xmas-sweets/CristmasSweetsTitle.webp";
import MakeSweetsTitleImg from "@assets/events/2025/xmas-sweets/Let'sMakeSweets.webp";
import locationTitleImg from "@assets/events/2025/xmas-sweets/locationTitle.webp";
import participateTitleImg from "@assets/events/2025/xmas-sweets/participateTitle.webp";
import scheduleTitleImg from "@assets/events/2025/xmas-sweets/scheduleTitle.webp";
import snowFlakeBigImg from "@assets/events/2025/xmas-sweets/snowFlakeBig.webp";
import snowFlakeSmallImg from "@assets/events/2025/xmas-sweets/snowFlakeSmall.webp";
import TPGLogoRedImg from "@assets/events/2025/xmas-sweets/TPGLogoRed.webp";







const title = "クリスマススイーツを作ろう！";
const description =
  "TPG コミュニティ班が12月23日（火）にクリスマススイーツ作りイベントを開催します！";
---

<Layout title={title} description={description}>
  <div class="content">
    
        <div class="titleSet">
            <Image class="TPGLogoRed" src={TPGLogoRedImg} alt="TPGのロゴ" />

            <Image class="snowFlakeBigLeft" src={snowFlakeBigImg} alt="雪の結晶のイラスト" />
            <Image class="CristmasSweetsTitle" src={CristmasSweetsTitleImg} alt="クリスマススイーツを作ろう！のタイトル画像" />
            <Image class="snowFlakeBigRight" src={snowFlakeBigImg} alt="雪の結晶のイラスト" />
      </div>
    
    <div class="intro">
      <Image class="MakeSweetsTitle" src={MakeSweetsTitleImg} alt="Let's Make Sweetsのタイトル画像" />
      <Image class="snowFlakeSmallLeft" src={snowFlakeSmallImg} alt="雪の結晶のイラスト" />
      <Image class="snowFlakeSmallRight" src={snowFlakeSmallImg} alt="雪の結晶のイラスト" />
      <p class="introText">TPG コミュニティ班が12月23日（火）にクリスマススイーツ作りイベントを開催します！<br>
        自分の手でカップケーキとアイシングクッキーを作ってみませんか？ <br>
        料理が得意な方も、苦手な方も大歓迎です！ <br>
        クリスマスのささやかな思い出を私たちと作りましょう♡ 
      </p>
    </div>
    <div class="container">
    <div class="schedule">
      <Image class="scheduleTitle" src={scheduleTitleImg} alt="スケジュールのタイトル画像" />
      <p class="date"><span class="big">12/23</span>(TUE)</p>
      <p class="time">
        17:30-17:45 自己紹介<br>
        17:45-18:15 カップケーキ作り<br>
        18:15-19:15 アイシング、デコレーション<br>
        19:15-19:30 片付け等
      </p>
    </div>
    <div class="location">
      <Image class="locationTitle" src={locationTitleImg} alt="場所のタイトル画像" />
      <p class="locationText">Taki Plaza B2F キッチン</p>
    </div>
    </div>
    <div class="participate">
      <Image class="participateTitle" src={participateTitleImg} alt="参加方法のタイトル画像" />
      <a href="https://docs.google.com/forms/d/e/1FAIpQLSeX_pwb8FoGJ8dDjXHb3t03uXK3E_n9jxHp8y0BwyvL100DqQ/viewform?usp=header">参加ご希望の方はこちらをクリック！</a>
    </div>
    </div>
  </div>
</Layout>

<style>
  @media screen and (max-width: 1024px) {
html {
      scroll-behavior: smooth; /* ページ内のボタンを押したときにスクロール風の動きをする */
      font-size: 1vw; /* rem単位の基準値 */
      padding: 0;
    }
    .content {
      background-color: #E40032;
      object-fit: fill;
      z-index: -15;
      fill: blur(3px);
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      text-align: center;
    }

    

    

    .titleSet{
      width: 100%;    /* 好きな横幅 */
      height: auto;         /* 好きな高さ：ここからはみ出さないように */
      padding-top: 5rem;
      padding-bottom: 5rem;
      
      margin-right: auto;        /* 画面中央 */
      margin-left: auto;
      box-sizing: border-box;
  
      display: flex;
      align-items: center;   /* 縦方向の中央にそろえる */
      justify-content: center; /* 横方向の中央にタイトルをおく */

      position: relative;
      overflow: hidden;      /* 雪の結晶が外にはみ出しても見せない */
      gap: 5rem;
      z-index: 0;
   }

    .snowFlakeBigLeft{
      width: 50%;
      height: auto;
      object-fit: contain;
      margin-right: auto;
    }

    .snowFlakeBigRight{
      width: 50%;
      height: auto;
      object-fit: contain;
      margin-left: auto; 
    }

    .CristmasSweetsTitle{
      position: relative;
      z-index: 10;
      width: 30%;
      height: auto;
      width: min(50%, 40rem);
    }

    

    .TPGLogoRed{
      position: absolute;
      z-index: -10;
      width: 50%;
      height: auto;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .intro{
      width: 100%;    /* 好きな横幅 */
      height: auto;
      background-color: #AE2A37;
      position: relative;
      
      
    }

    .snowFlakeSmallLeft{
      position: absolute;
      width: 15%;
      height: auto;
      left: 5rem;
      top: 15rem;
      flex-shrink: 0;   /* テキストに押しつぶされないように */

    }

    
    .snowFlakeSmallRight{
      position: absolute;
      width: 15%;
      height: auto;
      right: 5rem;
      top: 15rem;
      flex-shrink: 0;   /* テキストに押しつぶされないように */

    }

    .MakeSweetsTitle{
      margin-top: 3rem;
      margin-bottom: 5rem;
      width: 80%;
      height: auto;
    }

    .introText{
      color: white;
      font-size: 1rem;
      line-height: 5rem;
      letter-spacing: 0.3rem;
      padding-bottom: 5rem;
    }

    .container{
      display: flex;
      justify-content: center;
      gap: 5%;
    }

    .schedule{
      margin-top: 3rem;
      margin-bottom: 3rem;
    }

    .scheduleTitle{
      width: 80%;
      height: auto;
    } 

    .date{
      color: white;
      font-size: 1rem;
      margin-top: 2rem;
      margin-bottom: 2rem;
      letter-spacing: 0.3rem;
    }

    .big{
      font-size: 2rem;
    }

    .time{
      margin-left: 20%;
      text-align: left;
      color: white;
      font-size: 1rem;
      line-height: 3rem;
      letter-spacing: 0.2rem;
      margin-bottom: 2rem;
    }
    .location{
      margin-top: 2.9rem;
      margin-bottom: 2rem;
    }

    .locationTitle{
      width: 80%;
      height: auto;
    }

    .locationText{
      color: white;
      font-size: 1rem;
      margin-top: 30%;
      letter-spacing: 0.3rem;
    }

    .participate{
      background-color: #AE2A37;
      display: flex;
      justify-content: center;
      flex-direction: column;
      align-items: center;
    }

    .participateTitle{
      margin-top: 3rem;
      margin-bottom: 5rem;
      width: 80%;
      height: auto;
    }

    .participate a{

      color: white;
      font-size: 1.2rem;
      margin-bottom: 6rem;
      display: inline-block;
      
      
      
    }
    
