---
import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import B_01_restaurant001_3d_front 1 from "@assets/events/2025/stainedglass/suki.png";
import textPuzzleImg from "@assets/events/2025/stainedglass/puzzle.png";


const title = "Takiダイス";
const description =
  "四人組でリアルすごろくをするイベントを開催します!";
---

<Layout title={title} description={description}>
  <div class="content">
    <div class="original_header">
      <div class="language_selection">
        <p>日本語 / <a href="#">ENGLISH</a></p>
      </div>
      <div class="header_item_original">
        <a href="#schedule" class="headerSchdule">SCHEDULE</a>
        <a href="#location" class="headerLocation">LOCATION</a>
        <a href="#HowToParticipate" class="headerHowToParticioate">APPLY</a>
      </div>
    </div>
    <div class="background">
      <div class="title">
        <Image src={textSukiImg} class="suki" alt="好きでかたどる" />
        <Image src={textPuzzleImg} class="pazzle" alt="ガラスパズル" />
      </div>
      <p class="fee">初！ステンドグラス風作品づくり体験開催！<br />誰でも無料で参加できます！</p>
      <p class="announcement">TPGコミュニティ班が7月1日(火)に<br/>「好きでかたどるガラスパズル」イベントを開催します！</p>
      <p class="introduction">
        カラフルなガラスを組み合わせて、<br/>
        自分だけのステンドグラス風作品を作ってみませんか？<br/>
        普段から創作する人でもしない人でも大歓迎！<br />
        作品を通じて知らない人とも仲良くなれるかも？<br/>
        この機会にぜひ創作の楽しさを体験しよう！
      </p>
      <a name="schedule" class="schedule">SCHEDULE</a>
      <p class="date">1月20日(火)</p>
      <p class="scheduleText">
        17:00~18:00　1回目<br />
        18:00~19:00　2回目<br />
        19:00~20:00　3回目<br />
        20:00 　　　　解散
      </p>
      <a name="location" class="location">LOCATION</a>
      <p class="locationText">Taki Plaza B2F ワークショップルーム１</p>
      <a name="HowToParticipate" class="HowToParticipate">HOW TO PARTICIPATE</a>
      <a
        class="HowToParticipateText"
        href="https://docs.google.com/forms/d/e/1FAIpQLScpSNRkjyPYo131Y0C_yZ1KGQMQ1ahexNFGt9nGbqnlzwr3Jw/viewform?usp=header"
        >参加希望の方はここをクリック！</a
      >
    </div>
  </div>
</Layout>

<div id="dice-wrapper"></div>

<script>
  import * as THREE from 'three';
  // 角丸ボックス用のジオメトリをインポート
  import { RoundedBoxGeometry } from 'three-stdlib';

  const container = document.getElementById('dice-wrapper');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(75, 1, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(400, 400);
  container.appendChild(renderer.domElement);

  // --- 1. テクスチャ作成 ---
  function createDiceTexture(number) {
    const canvas = document.createElement('canvas');
    canvas.width = 256; // 高解像度化
    canvas.height = 256;
    const ctx = canvas.getContext('2d');
    
    // 背景と角丸の描画（テクスチャ自体も少し余白を持たせると綺麗）
    ctx.fillStyle = 'white';
    ctx.fillRect(0, 0, 256, 256);
    
    ctx.fillStyle = 'black';
    const dotRadius = 25;
    const positions = {
      1: [[128, 128]],
      2: [[64, 64], [192, 192]],
      3: [[64, 64], [128, 128], [192, 192]],
      4: [[64, 64], [64, 192], [192, 64], [192, 192]],
      5: [[64, 64], [64, 192], [128, 128], [192, 64], [192, 192]],
      6: [[64, 64], [64, 128], [64, 192], [192, 64], [192, 128], [192, 192]]
    };

    positions[number].forEach(([x, y]) => {
      ctx.beginPath(); ctx.arc(x, y, dotRadius, 0, Math.PI * 2); ctx.fill();
    });
    return new THREE.CanvasTexture(canvas);
  }

  const materials = [
    new THREE.MeshStandardMaterial({ map: createDiceTexture(1) }),
    new THREE.MeshStandardMaterial({ map: createDiceTexture(6) }),
    new THREE.MeshStandardMaterial({ map: createDiceTexture(2) }),
    new THREE.MeshStandardMaterial({ map: createDiceTexture(5) }),
    new THREE.MeshStandardMaterial({ map: createDiceTexture(3) }),
    new THREE.MeshStandardMaterial({ map: createDiceTexture(4) }),
  ];

  // --- 2. 角丸ジオメトリの適用 ---
  // 引数: (幅, 高さ, 奥行き, 分割数, 角の半径)
  const geometry = new RoundedBoxGeometry(2.5, 2.5, 2.5, 6, 0.2);
  const dice = new THREE.Mesh(geometry, materials);
  scene.add(dice);

  // 照明（角の丸みを強調するために少し強めに）
  const light = new THREE.DirectionalLight(0xffffff, 1.2);
  light.position.set(5, 5, 5);
  scene.add(light);
  scene.add(new THREE.AmbientLight(0xffffff, 0.6));
  
  camera.position.z = 6;

  // 速度管理
  let currentSpeed = 0.5;
  const targetSpeed = 0.01;
  const friction = 0.98;

  function animate() {
    requestAnimationFrame(animate);
    if (currentSpeed > targetSpeed) currentSpeed *= friction;
    else currentSpeed = targetSpeed;

    dice.rotation.x += currentSpeed;
    dice.rotation.y += currentSpeed;
    renderer.render(scene, camera);
  }
  animate();
</script>

<style>
  #dice-wrapper { display: flex; justify-content: center; }
</style>