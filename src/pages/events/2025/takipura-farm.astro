        margin: 30px auto;
    }

    .content {
        margin: 255px auto 0px;
        width: 90%;
        height: auto;
        padding-bottom: 30px;
        text-align: center;
        border-radius: 50px;
        background-color: #fff;
    }
    .content_title {
        margin: 50px auto 10px;
        width: 20%;
        height: auto;
    }
    .content_text {
        margin-top: 50px;
        margin-bottom: 50px;
        font-size: 1rem;
        letter-spacing: 0.30em;
        text-align: center;
        color: #2f4c29;
        line-height: 90px;
        margin-bottom: 50px;
