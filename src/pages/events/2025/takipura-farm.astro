    }

    .place {
        width: 45%;
        height: auto;
        background-color: #fff;
        text-align: center;
        border-radius: 50px;
        padding-bottom: 30px;
    }

    .place_title {
        margin: 30px auto 10px;
        width: 30%;
        height: auto;
    }

    .place_content {
        margin-top: 100px;
        font-size: 1rem;
        letter-spacing: 0.30em;
        text-align: center;
        color: #2F4C29;
        line-height: 90px;
    }

    .apply {
