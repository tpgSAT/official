---
import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import backgroundImg from "@assets/events/2025/shinnnyuuseikangeikai/background.jpeg";

const title = "新入生交流会";
const description =
  "TPGでは、ボードゲームを通して新入生が自由に交流できるイベントを開催します。";
---

<Layout title={title} description={description}>
    <div class="content" style={`background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url(${backgroundImg.src});`}>
        <p class="ST">SCIENCE TOKYO</p>
        <p class="contentTitle">新入生交流会</p>
        <p class="contentDate">3/28 in Taki Plaza</p>
    </div>
    <div class="about">
        <h4 class="aboutTitle">ABOUT</h4>
        <p class="aboutText">
            TPGでは、ボードゲームを通じて新入生が自由に交流できるイベントを開催します。<br/>
            会場には様々なボードゲームを用意しており、初心者の方でも安心して楽しめます。<br/>
            途中参加・途中退出は自由で、当日の飛び入り参加も可能です。<br/>
            また、工大祭のボードゲームカフェと同様にお菓子やジュースも用意しています。<br/>
            参加費は無料ですので、ぜひ気軽にお越しください。
        </p>
    </div>
    <div class="schedule">
        <h4 class="scheduleTitle">SCHEDULE</h4>
        <p class="scheduleDate">２０２６年３月２７日 （金）   １０：００～１７：００</p>
        <p class="scheduleDate">２０２６年３月３０日 （月）   １０：００～１７：００</p>
        <p class="scheduleDate">２０２６年３月３１日 （火）   １０：００～１７：００</p>
    </div>
</Layout>

