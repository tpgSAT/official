---
import Layout from "@layouts/Layout.astro";

const title = "たき地下サバゲー";
const description =
  "TPG イベント班が2026年11月9日(月)に Taki Plaza 地下2階 ワークショップルームでスポンジ弾を使ったサバゲーを開催します！";
---

<Layout title={title} description={description}>
  <div class="sabage-page">
    <section class="hero">
      <p class="hero-label">Taki Plaza Gardener presents</p>
      <h1 class="hero-title">たき地下サバゲー</h1>
      <p class="hero-date">2026.11.09 MON 17:00 - 20:00</p>
    </section>

    <div class="container">
      <section class="block">
        <h2 class="block-title">サバゲーを開催します</h2>
        <p class="block-text">
          Taki Plaza 地下2階のワークショップルームで、スポンジ弾を使ったサバイバルゲームを開催します。<br />
          チームで協力しながら、体を動かして楽しみましょう！
        </p>
      </section>

      <section class="block">
        <h2 class="block-title">開催情報</h2>
        <dl class="info">
          <div class="info-row">
            <dt>日時</dt>
            <dd>2026年11月9日（月）17:00～20:00</dd>
          </div>
          <div class="info-row">
            <dt>場所</dt>
            <dd>Taki Plaza 地下2階 ワークショップルーム1・2</dd>
          </div>
          <div class="info-row">
            <dt>主催</dt>
            <dd>Taki Plaza Gardener イベント班</dd>
          </div>
          <div class="info-row">
            <dt>問い合わせ</dt>
            <dd>
              <a href="mailto:takiplazagardener.event@gmail.com">
                takiplazagardener.event@gmail.com
              </a>
            </dd>
          </div>
        </dl>
      </section>

      <section class="block">
        <h2 class="block-title">参加にあたって</h2>
        <div class="notice" role="note">
          <svg class="notice-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2 1 21h22L12 2Zm1 16h-2v-2h2v2Zm0-4h-2v-4h2v4Z" fill="currentColor"></path>
          </svg>
          <div class="notice-body">
            <p class="notice-title">参加には同意事項への同意が必要です</p>
            <p class="notice-text">参加前に、同意事項の内容をご確認いただきますようお願いいたします。</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .sabage-page {
    --olive: #4b5320;
    --olive-dark: #2f3414;
    --sand: #e8e0c8;
    --accent: #e07a1f;
    --text: #1a1a1a;
    --text-sub: #4d4d4d;
    --border: #cccccc;
    --notice-border: #b85a00;
    --notice-bg: #fff6ec;

    min-height: 100vh;
    background-color: var(--sand);
    color: var(--text);
    font-family: "Noto Sans JP Variable", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: 0.02em;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    padding: 18vh 16px 12vh;
    text-align: center;
    color: var(--sand);
    background-color: var(--olive-dark);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 24px,
      rgba(255, 255, 255, 0.04) 24px 48px
    );
  }

  .hero-label {
    margin: 0;
    font-size: clamp(12px, 1.6vw, 16px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(36px, 8vw, 88px);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  .hero-date {
    margin: 0;
    padding: 0.3em 1em;
    font-size: clamp(14px, 2.4vw, 22px);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--olive-dark);
    background-color: var(--accent);
    border-radius: 4px;
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 820px;
    margin: 0 auto;
    padding: 56px 16px 80px;
  }

  .block {
    padding: 28px 24px;
    background-color: #fff;
  }

  .block-title {
    margin: 0 0 24px;
    font-size: clamp(24px, 3.2vw, 32px);
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
  }

  .block-text {
    margin: 0;
  }

  .info {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .info-row {
    display: grid;
    grid-template-columns: 8em 1fr;
    gap: 16px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-row dt {
    font-weight: 700;
  }

  .info-row dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .info-row a {
    color: #0031d8;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .info-row a:hover {
    color: #00118f;
    text-decoration-thickness: 3px;
  }

  .info-row a:focus-visible {
    outline: 4px solid #000;
    outline-offset: 2px;
    background-color: #ffd43d;
    border-radius: 4px;
  }

  .notice {
    display: flex;
    gap: 12px;
    padding: 20px 24px;
    background-color: var(--notice-bg);
    border: 3px solid var(--notice-border);
    border-radius: 12px;
  }

  .notice-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-top: 2px;
    color: var(--notice-border);
  }

  .notice-title {
    margin: 0 0 4px;
    font-weight: 700;
  }

  .notice-text {
    margin: 0;
    color: var(--text-sub);
  }

  @media screen and (max-width: 600px) {
    .container {
      padding: 40px 16px 64px;
    }

    .info-row {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 16px;
    }

    .notice {
      padding: 16px;
    }
  }
</style>
