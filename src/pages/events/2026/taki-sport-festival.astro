---
import Layout from "@layouts/Layout.astro";

const title = "Taki運動会　〜遊び尽くせ！〜";
const description = "filler"; // TODO
---

<Layout title={title} description={description}>
  <div class="event-page">
    <div class="event-bg" aria-hidden="true">
      <svg viewBox="0 0 1200 1600" preserveAspectRatio="none">
        <defs>
          <filter id="rough-lines">
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.018 0.12"
              numOctaves="2"
              seed="4"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" scale="18"
            ></feDisplacementMap>
          </filter>
        </defs>

        <path class="red-line" d="M-140 260 C 220 120, 620 40, 1340 -200"
        ></path>
        <path class="black-line" d="M-180 520 C 260 390, 640 300, 1400 90"
        ></path>
        <path class="red-line" d="M-160 960 C 340 720, 780 620, 1360 400"
        ></path>
        <path class="black-line" d="M-200 1220 C 220 980, 720 900, 1400 700"
        ></path>
        <path class="red-line" d="M-240 1500 C 320 1240, 840 1080, 1400 820"
        ></path>

        <!--text class="gray-word" x="60" y="1380" transform="rotate(-72 60 1380)">
          TAKI PLAZA
        </text>
        <text
          class="gray-word"
          x="930"
          y="1470"
          transform="rotate(-68 930 1470)"
        >
          GARDENER
        </text-->
      </svg>
    </div>

    <div class="content-column-wrapper">
      <section class="hero">
        <div class="hero-inner">
          <p class="kicker">Taki Plaza Gardener presents</p>

          <svg
            class="rough-title"
            viewBox="0 0 1200 360"
            role="img"
            aria-label="Taki 運動会"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <filter id="rough-title-main-filter">
                <feTurbulence
                  type="fractalNoise"
                  baseFrequency="0.022 0.09"
                  numOctaves="2"
                  seed="7"
                  result="noise"></feTurbulence>
                <feDisplacementMap
                  in="SourceGraphic"
                  in2="noise"
                  scale="12"
                  xChannelSelector="R"
                  yChannelSelector="G"></feDisplacementMap>
              </filter>

              <filter id="rough-title-shadow-filter">
                <feTurbulence
                  type="fractalNoise"
                  baseFrequency="0.03 0.12"
                  numOctaves="2"
                  seed="13"
                  result="noise"></feTurbulence>
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="8"
                ></feDisplacementMap>
              </filter>
            </defs>
          </svg>
        </div>

        <div class="stamp" aria-label="参加費無料">
          <svg viewBox="-160 -160 320 320" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <path
                id="star"
