</Layout>

<style>
  .event-page {
    --red: #f20d0d;
    --black: #050505;
    --white: #ffffff;
    --gray: #b8b8b8;
    --beige: #e2cf9c;

    position: relative;
    min-height: 100vh;
    overflow: clip;
    isolation: isolate;
    background: var(--beige);
    color: var(--black);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "Noto Sans JP",
      sans-serif;
  }

  .event-page * {
    box-sizing: border-box;
  }

  .content-column-wrapper {
    position: relative;
    z-index: 1;

    width: min(94vw, 960px);
    margin-inline: auto;
    min-height: 100vh;

    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(2px);
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  .event-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.9;
  }

  .event-bg svg {
    width: 100%;
    height: 100%;
  }

  .event-bg path {
    fill: none;
    stroke-linecap: square;
    stroke-dasharray: none;
    stroke-dashoffset: 0;
    animation: none;
  }

  .event-bg .red-line {
    stroke: var(--red);
    stroke-width: 42;
  }

  .event-bg .black-line {
    stroke: var(--black);
    stroke-width: 28;
  }

  .event-bg .gray-word {
    fill: var(--gray);
    font-size: 150px;
    font-weight: 1000;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  .hero {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 5vw, 4rem);
  }

  .hero-inner {
    width: min(1120px, 100%);
    transform: rotate(-5deg);
  }

  .stamp {
    position: absolute;
    top: clamp(1rem, 5vw, 4rem);
    right: 0;
    width: clamp(120px, 20vw, 200px);
  }

  .stamp-border {
    fill: none;
    stroke: var(--red);
  }

  .stamp-rect {
    fill: var(--white);
    stroke: var(--red);
  }

  .stamp-content {
    fill: var(--red);
    stroke: none;
  }

  .kicker {
    margin: 0 0 1rem;
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    font-weight: 1000;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .tagline {
    display: inline-block;
    margin: -1rem 0 2rem;
