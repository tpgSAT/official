---
import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import BlogCard from '@components/BlogCard.astro';
import { getPosts } from '@lib/api';

const FallbackThumbnail = '/blog-fallback-thumbnail.jpg';

const posts = await getPosts();

const ListItem = [
  { path: 'blog', name: 'ブログ記事' },
];
---

<Layout title="Blog">
    <Breadcrumb lists={ListItem} />
    <div id="root">
        <h1>ブログ記事</h1>
		<div class="blog-content-wrapper">
		{[...posts].map(post => <BlogCard post={post} />)}
		</div>
    </div>
</Layout>

<style>
    #root {
        margin: 0 5vw 40px;
    }

    #root h1 {
        font-family: 'Midashi Go MB31', 'Noto Sans JP Variable', sans-serif;
        font-size: 28px;
        letter-spacing: 2px;
        font-weight: 500;
    }

	/* デスクトップ用のCSS */
    @media screen and (min-width: 769px) {
		.blog-content-wrapper {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: flex-start;
			margin: 100px 0 0;
		}
    }
</style>