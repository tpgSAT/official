---
import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const FallbackThumbnail = '/blog-fallback-thumbnail.jpg';

const res = await fetch("https://cms.tpgd.jp/wp-json/wp/v2/posts?per_page=40&_embed");
const posts = await res.json();

const ListItem = [
  { path: 'blog', name: 'ブログ記事' },
];
---

<Layout title="Blog">
    <Breadcrumb lists={ListItem} />
    <div id="root">
        <h1>ブログ記事</h1>
        {[...posts].map(post => {
        // 🔸 サムネイルURLを取得（なければデフォルト表示）
        const thumbnail =
            post._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.medium?.source_url ||
            post._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
            FallbackThumbnail;
        
        // 🔸 カテゴリ名の配列を取得（なければ空配列）
        const categories = post._embedded?.['wp:term']?.[0]?.map(cat => cat.name) || [];

        return (
            <a href={`/blog/${post.id}`}>
                <div class="blog-content">
                    <img src={thumbnail} class="blog-thumbnail" alt={post.title.rendered} />
                    <div class="blog-tags"><p class="blog-tag">{categories?.join(' ')}</p></div>
                    <h3 class="blog-title">{post.title.rendered}</h3>
                    <p class="blog-date">{new Date(post.date).toLocaleDateString('ja-JP')}</p>
                </div>
            </a>
        );
        })}
    </div>
</Layout>

<style>
    #root {
        margin: 0 5vw 40px;
    }

    #root h1 {
        font-family: 'Midashi Go MB31', 'Noto Sans JP Variable', sans-serif;
        font-size: 28px;
        letter-spacing: 2px;
        font-weight: 500;
    }

    .blog-content {
        font-family: 'Noto Sans JP Variable', sans-serif;
		padding: 15px 0 0;
		display: grid;
		grid-template-columns: 40% 1fr;
		grid-template-rows: 20px 1fr 20px;
		gap: 0 10px;
	}

	.blog-thumbnail {
		width: 100%;
		aspect-ratio: 16 / 10;
	    object-fit: cover;
		border-radius: 10px;
		grid-column: 1 / 2;
		grid-row: 1 / 4;
	}

	.blog-tags, .blog-date{
		font-weight: 400;
		font-size: 10px;
		letter-spacing: 0.4px;
		color: #707070;
		margin: 0;
		display: inline-block;
		grid-column: 2 / 3;
	}

	.blog-title {
		font-weight: 500;
		font-size: 14px;
		margin: 0;
		padding: 0;
		grid-column: 2 / 3;
		grid-row: 2 / 3;
	}

	.blog-tags {
		grid-row: 1 / 2;
	}

	.blog-tag {
		padding: 0;
		margin: 0;
	}

	.blog-date {
		grid-row: 3 / 4;
	}
</style>