---
import Layout from '@layouts/Layout.astro';
import BlogArticle from '@components/BlogArticle.astro';
import { getPreviewPost } from '@lib/api';
import { DIRECTUS_PREVIEW_TOKEN, PREVIEW_SECRET } from 'astro:env/server';

// Directus で編集中の記事を表示するページ。ビルド時には生成せず、リクエストごとに描画する
// Directus の Preview URL: https://tpgd.jp/blog/preview/{{UUID}}?secret=<PREVIEW_SECRET>&version={{$version}}
export const prerender = false;

const headers = {
  'Cache-Control': 'private, no-store',
  'X-Robots-Tag': 'noindex',
  'Referrer-Policy': 'no-referrer',
  // Directus の編集画面に iframe で埋め込めるようにする
  'Content-Security-Policy': 'frame-ancestors https://directus.tpgd.jp',
};
const notFound = () => new Response('Not Found', { status: 404, headers });

const { id } = Astro.params;
const secret = Astro.url.searchParams.get('secret');
const versionParam = Astro.url.searchParams.get('version');
// 公開中の内容（main）を見るときは version を付けずに取得する
const version = versionParam && versionParam !== 'main' ? versionParam : undefined;

if (!id || !PREVIEW_SECRET || !DIRECTUS_PREVIEW_TOKEN || secret !== PREVIEW_SECRET) {
  return notFound();
}

let post = null;
try {
  post = await getPreviewPost(id, DIRECTUS_PREVIEW_TOKEN, version);
} catch (error) {
  console.error(error);
}
if (!post) {
  return notFound();
}

for (const [key, value] of Object.entries(headers)) {
  Astro.response.headers.set(key, value);
}
---
<Layout title={`[プレビュー] ${post.title}`}>
    <p class="preview-banner">プレビュー表示です（公開前の内容を含みます）</p>
    <BlogArticle post={post} />
</Layout>

<style>
  .preview-banner {
    margin: 0 0 10px;
    padding: 8px 5vw;
    font-family: 'Noto Sans JP Variable', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.6px;
    text-align: center;
    background-color: #fff3c4;
    color: #5c4a00;
  }
</style>
