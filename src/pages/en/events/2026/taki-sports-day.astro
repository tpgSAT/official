---
import Layout from "@layouts/Layout.astro";

import key from "@assets/events/2026/taki-sports-day/key.webp";
import background from "@assets/events/2026/taki-sports-day/background.webp";

const title = "Taki Sports Day 2026 | Play to Your Heart's Content!";
const description = "Join Taki Sports Day on July 13, 2026 at Taki Plaza B2F. Enjoy games, activities, and prizes with Taki Plaza Gardener.";
---

<Layout title={title} description={description}>
  <div class="event-page">
    <div class="event-bg" aria-hidden="true">
      <img src={background.src} alt="" class="event-bg-image" />
    </div>

    <div class="content-column-wrapper">
      <section class="hero">
        <div class="hero-inner">
          <p class="kicker">Taki Plaza Gardener presents</p>
          <img src={key.src} alt="Taki Sports Day 2026 Key Visual" class="key-visual" />
        </div>

        <div class="stamp" aria-hidden="true">
          <svg viewBox="-160 -160 320 320" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <path
                id="star"
                d="M 0.000,-8.000 L 1.796,-2.472 L 7.608,-2.472 L 2.906,0.944 L 4.702,6.472 L 0.000,3.056 L -4.702,6.472 L -2.906,0.944 L -7.608,-2.472 L -1.796,-2.472 Z"
              ></path>
            </defs>
            <g transform="rotate(24)">
              <circle class="stamp-border" stroke-width="5" r="78"></circle>
              <circle class="stamp-border" stroke-width="5" r="88"></circle>
              <circle class="stamp-border" stroke-width="5" r="132"></circle>
              <circle class="stamp-border" stroke-width="10" r="144"></circle>
              <rect
                class="stamp-rect"
                stroke-width="5"
                x="-156"
                y="-40"
                width="312"
                height="80"></rect>
              <use
                class="stamp-content"
                href="#star"
                transform="translate(24,-56) scale(1.3)"></use>
              <use
                class="stamp-content"
                href="#star"
                transform="translate(0,-56) scale(1.3)"></use>
              <use
                class="stamp-content"
                href="#star"
                transform="translate(-24,-56) scale(1.3)"></use>
              <use
                class="stamp-content"
                href="#star"
                transform="translate(24,56) scale(1.3) rotate(180)"></use>
              <use
                class="stamp-content"
                href="#star"
                transform="translate(0,56) scale(1.3) rotate(180)"></use>
              <use
                class="stamp-content"
                href="#star"
                transform="translate(-24,56) scale(1.3) rotate(180)"></use>
              <path class="stamp-content" transform="scale(0.7) translate(-215.5 -55.5)" d="M18.900 59.475L18.900 80.175L6.300 80.175L6.300 26.625L37.425 26.625L37.425 36.975L18.900 36.975L18.900 49.125L36.075 49.125L36.075 59.475L18.900 59.475ZM69.750 38.250L69.750 38.250Q70.950 38.250 72.225 38.362Q73.500 38.475 74.175 38.700L74.175 38.700L73.050 50.625Q72.225 50.475 71.137 50.325Q70.050 50.175 68.250 50.175L68.250 50.175Q66.675 50.175 65.025 50.587Q63.375 51 61.950 52.013Q60.525 53.025 59.625 54.825Q58.725 56.625 58.725 59.550L58.725 59.550L58.725 80.175L46.050 80.175L46.050 39L55.575 39L57.525 45.750L58.125 45.750Q59.250 43.650 61.050 41.925Q62.850 40.200 65.100 39.225Q67.350 38.250 69.750 38.250ZM98.325 38.250L98.325 38.250Q104.250 38.250 108.487 40.350Q112.725 42.450 115.012 46.650Q117.300 50.850 117.300 57L117.300 57L117.300 62.925L91.275 62.925Q91.425 66.900 93.937 69.300Q96.450 71.700 101.175 71.700L101.175 71.700Q105.075 71.700 108.225 70.950Q111.375 70.200 114.750 68.625L114.750 68.625L114.750 77.925Q111.750 79.500 108.300 80.212Q104.850 80.925 99.750 80.925L99.750 80.925Q93.525 80.925 88.725 78.675Q83.925 76.425 81.187 71.737Q78.450 67.050 78.450 59.850L78.450 59.850Q78.450 52.500 80.962 47.737Q83.475 42.975 87.937 40.612Q92.400 38.250 98.325 38.250ZM98.700 47.025L98.700 47.025Q95.700 47.025 93.825 48.938Q91.950 50.850 91.575 54.675L91.575 54.675L105.600 54.675Q105.600 52.500 104.812 50.813Q104.025 49.125 102.487 48.075Q100.950 47.025 98.700 47.025ZM143.850 38.250L143.850 38.250Q149.775 38.250 154.012 40.350Q158.250 42.450 160.537 46.650Q162.825 50.850 162.825 57L162.825 57L162.825 62.925L136.800 62.925Q136.950 66.900 139.463 69.300Q141.975 71.700 146.700 71.700L146.700 71.700Q150.600 71.700 153.750 70.950Q156.900 70.200 160.275 68.625L160.275 68.625L160.275 77.925Q157.275 79.500 153.825 80.212Q150.375 80.925 145.275 80.925L145.275 80.925Q139.050 80.925 134.250 78.675Q129.450 76.425 126.712 71.737Q123.975 67.050 123.975 59.850L123.975 59.850Q123.975 52.5