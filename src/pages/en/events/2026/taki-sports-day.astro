6.500L292.275 26.625L305.100 26.625L305.100 75.900Q305.100 83.325 302.813 87.862Q300.525 92.400 296.512 94.388Q292.500 96.375 287.175 96.375ZM355.275 59.475L355.275 59.475Q355.275 64.575 353.887 68.587Q352.500 72.600 349.837 75.337Q347.175 78.075 343.425 79.500Q339.675 80.925 334.950 80.925L334.950 80.925Q330.525 80.925 326.813 79.500Q323.100 78.075 320.438 75.337Q317.775 72.600 316.275 68.587Q314.775 64.575 314.775 59.475L314.775 59.475Q314.775 52.650 317.212 47.887Q319.650 43.125 324.225 40.688Q328.800 38.250 335.175 38.250L335.175 38.250Q341.025 38.250 345.563 40.688Q350.100 43.125 352.688 47.887Q355.275 52.650 355.275 59.475ZM327.675 59.475L327.675 59.475Q327.675 63.225 328.425 65.925Q329.175 68.625 330.825 69.975Q332.475 71.325 335.100 71.325L335.100 71.325Q337.725 71.325 339.300 69.975Q340.875 68.625 341.625 65.925Q342.375 63.225 342.375 59.475L342.375 59.475Q342.375 55.650 341.625 53.063Q340.875 50.475 339.262 49.125Q337.650 47.775 335.025 47.775L335.025 47.775Q331.125 47.775 329.400 50.775Q327.675 53.775 327.675 59.475ZM363.975 39L376.650 39L376.650 80.175L363.975 80.175L363.975 39ZM370.350 22.575L370.350 22.575Q373.125 22.575 375.150 23.813Q377.175 25.050 377.175 28.500L377.175 28.500Q377.175 31.875 375.150 33.112Q373.125 34.350 370.350 34.350L370.350 34.350Q367.500 34.350 365.512 33.112Q363.525 31.875 363.525 28.500L363.525 28.500Q363.525 25.050 365.512 23.813Q367.500 22.575 370.350 22.575ZM411.825 38.250L411.825 38.250Q418.425 38.250 422.400 41.813Q426.375 45.375 426.375 53.325L426.375 53.325L426.375 80.175L413.625 80.175L413.625 56.850Q413.625 52.575 412.237 50.438Q410.850 48.300 407.775 48.300L407.775 48.300Q403.200 48.300 401.550 51.675Q399.900 55.050 399.900 61.425L399.900 61.425L399.900 80.175L387.225 80.175L387.225 39L396.825 39L398.625 44.475L399.150 44.475Q400.500 42.450 402.337 41.063Q404.175 39.675 406.575 38.962Q408.975 38.250 411.825 38.250Z" />

            </g>
          </svg>
        </div>

        <div class="hero-info">
          <p class="hero-title-en">Taki Sports Day</p>
          <p class="hero-date">
            <span class="hero-date-year">2026.</span><span class="hero-date-em"
              >7</span
            ><span class="hero-date-mid">.</span><span class="hero-date-em"
              >13</span
            ><span class="hero-date-mid">(Mon)</span>
          </p>
          <p>17:00 - 20:00</p>
          <p>Taki Plaza B2</p>
          <a class="page-link" href={('/events/2026/taki-sports-day')}>日本語のページはこちら</a>
        </div>
      </section>

      <section class="about">
        <p class="eyebrow">About</p>
        <h2 class="tagline">Play to Your Heart's Content!</h2>
        <div class="intro-card">
          <p>
            The Taki Plaza Gardener Event Team will host <span class="red">Taki Sports Day</span> on Monday, July 13, at Taki Plaza B2F!
          </p>
          <p>
            Enjoy classic Japanese school sports day activities, including tug-of-war and item relay races.
          </p>
          <p>
            Come join us, get moving, and make memories together across years, fields, and nationalities!
          </p>
        </div>
      </section>

      <section class="activity">
        <p class="eyebrow">What to expect</p>
        <h2 class="tagline">Activities</h2>
        <div class="activity-grid">
          <article class="activity-card">
            <p class="activity-number">01</p>
            <h3>Tissue Box Table Tennis</h3>
            <p>
              The well-received <span class="red">Tissue Box Table Tennis</span> will be back at Taki Sports Day!
            </p>
            <p>
              Play table tennis using an item familiar to science and engineering students: KimWipes!
            </p>
          </article>
          <article class="activity-card">
            <p class="activity-number">02</p>
            <h3>Quiz Item Relay Race</h3>
            <p>
              A popular event at Japanese school sports days, now with a quiz twist!
            </p>
            <p>
              Test your knowledge and speed in this unique item relay race!
            </p>
          </article>
          <article class="activity-card">
            <p class="activity-number">03</p>
            <h3>Struck Out Showdown</h3>
            <p>
              A fast-paced target-throwing challenge with unlimited throws within the time limit!
            </p>
            <p>
              Stay calm, aim for the targets, and go for a high score!
            </p>
          </article>
          <article class="activity-card">
            <p class="activity-number">04</p>
            <h3>Tug-of-War Showdown</h3>
            <p>
              Work together and pull your way to victory!
            </p>
            <p>
              Any number of participants is welcome, whether you're going solo or in a group!
            </p>
            <p>
              Team up, match your timing, and take on an exciting tug-of-war challenge!
            </p>
            <p class="red">
              * Sandals are not allowed for this activity.
            </p>
          </article>
          <article class="activity-card">
            <p class="activity-number">05</p>
            <h3>Refreshment Stand</h3>
            <p>
              Exchange the tickets you earn from other activities for ice cream, juice, and other treats.
            </p>
            <p>
              We'll have plenty of options waiting for you!
            </p>
          </article>
        </div>
      </section>

      <section class="info">
        <p class="eyebrow">Things you should know</p>
        <h2 class="tagline">Event Information</h2>
        <div class="info-card">
          <dl class="info-list">
            <div class="info-row">
              <dt>Time & Date</dt>
              <dd>July 13, 2026 (Mon) 17:00 - 20:00</dd>
            </div>

            <div class="info-row">
              <dt>Location</dt>
              <dd>Taki Plaza B2F</dd>
            </div>

            <div class="info-row">
              <dt>Entry Fee</dt>
              <dd>Free</dd>
            </div>

            <div class="info-row">
              <dt>Contact</dt>
              <dd>
                <a href="mailto:takiplazagardener.event@gmail.com">
                  takiplazagardener.event@gmail.com
                </a>
              </dd>
            </div>

            <div class="info-row">
              <dt>Host</dt>
              <dd>Taki Plaza Gardener</dd>
            </div>

            <div class="info-row">
              <dt>Sponsor</dt>
              <dd><a href="https://www.kuramae.ne.jp/">Kuramae Alumni Association of Science Tokyo</a></dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="notes">
        <p class="eyebrow">For Your Safety</p>
        <h2 class="tagline">Things to Note</h2>

        <div class="notes-card">
          <ul class="notes-list">
            <li>Please wear comfortable clothing that allows you to move easily.</li>
            <li>Athletic shoes are required for some activities.</li>
            <li>Please do not participate if you are feeling unwell.</li>
            <li>Event details may change without prior notice.</li>
          </ul>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .event-page {
    --red: #f20d0d;
    --black: #050505;
    --white: #ffffff;
    --gray: #b8b8b8;
    --beige: #f4f0e6;

    position: relative;
    min-height: 100vh;
    overflow: clip;
    isolation: isolate;
    background: var(--beige);
    color: var(--black);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "Noto Sans JP",
      sans-serif;
  }

  .event-page * {
    box-sizing: border-box;
  }

  .content-column-wrapper {
    position: relative;
    z-index: 1;

    width: min(94vw, 960px);
    margin-inline: auto;
    min-height: 100vh;

    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(2px);
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  .event-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .event-bg-image {
    position: absolute;
    top: 0;
    left: 50%;
    height: max(100%, 100vh);
    width: auto;
    min-width: 100%;
    object-fit: cover;
    object-position: center top;
    transform: translateX(-50%) translateY(var(--bg-y, 0px));
    will-change: transform;
    opacity: 0.9;
  }

  .key-visual {
    display: block;
    width: min(80%, 760px);
    height: auto;
    margin-inline: auto;
  }

  .hero {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 5vw, 2rem) clamp(1rem, 5vw, 4rem) 0
      clamp(1rem, 5vw, 4rem);
  }

  .hero-inner {
    width: min(1120px, 100%);
    transform: rotate(-5deg);
  }

  .hero-info {
    position: absolute;
    left: clamp(1rem, 5vw, 4rem);
    bottom: -1.5rem;
    z-index: 3;
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    background: rgb(255 255 255 / 0.88);
    border: 4px solid var(--black);
    box-shadow: 8px 8px 0 var(--black);
    color: var(--black);
    font-weight: 800;
    line-height: 1;
    transform: rotate(-2deg);
  }

  .hero-info p {
    margin: 0;
    font-size: clamp(1.05rem, 2.3vw, 1.55rem);
    letter-spacing: -0.03em;
  }

  .hero-title-en {
    font-size: clamp(1.5rem, 3.5vw, 2.8rem);
    font-weight: 1000;
    letter-spacing: -0.05em;
  }

  .hero-date {
    color: var(--red);
    white-space: nowrap;
  }

  .hero-date-year {
    font-size: clamp(1rem, 2vw, 1.35rem);
  }

  .hero-date-mid {
    font-size: clamp(1.15rem, 2.6vw, 1.8rem);
  }

  .hero-date-em {
    font-size: clamp(2.1rem, 6vw, 3.3rem);
    letter-spacing: -0.08em;
  }

  .red {
    color: var(--red);
  }

  .stamp {
    position: absolute;
    top: clamp(1rem, 5vw, 4rem);
    right: 0;
    width: clamp(120px, 20vw, 200px);
  }

  .stamp-border {
    fill: none;
    stroke: var(--red);
  }

  .stamp-rect {
    fill: var(--white);
    stroke: var(--red);
  }

  .stamp-content {
    fill: var(--red);
    stroke: none;
  }

  .kicker {
    margin: 0 0 1rem;
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    font-weight: 1000;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .tagline {
    display: inline-block;
    margin: -1rem 0 2rem;
    padding: 0.25em 0.55em;
    background: var(--black);
    color: var(--white);
    font-size: clamp(2rem, 7vw, 5rem);
    font-weight: 1000;
    line-height: 0.95;
    transform: rotate(-2deg);
  }

  .eyebrow {
    margin: 0 0 2rem;
    color: var(--red);
    transform: rotate(-2deg);
    font-size: 1rem;
    font-weight: 1000;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .activity > .eyebrow,
  .activity > .tagline,
  .info > .eyebrow,
  .info > .tagline,
  .notes > .eyebrow,
  .notes > .tagline {
    text-align: left;
    justify-self: start;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-size: clamp(1.1rem, 2.6vw, 2rem);
    font-weight: 1000;
  }

  .meta span {
    padding: 0.25em 0.45em;
    background: var(--white);
    border: 4px solid var(--black);
    box-shadow: 8px 8px 0 var(--black);
  }

  .info {
    position: relative;
    padding: clamp(4rem, 10vw, 8rem) clamp(1rem, 5vw, 4rem);
  }

  .intro-card,
  .notes-card,
  .info-card {
    width: calc(100% - 16px);
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem);
    background: rgb(255 255 255 / 0.92);
    border: 5px solid var(--black);
    box-shadow: 12px 12px 0 var(--black);
    transform: rotate(1deg);
  }

  .intro-card {
    transform: rotate(-1deg);
  }

  .notes-card {
    transform: rotate(1deg);
  }

  .intro-card p {
    margin: 0;
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    font-weight: 800;
    line-height: 1.8;
  }

  .intro-card p + p {
    margin-top: 1rem;
  }

  .info-list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .info-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--black);
  }

  .info-row dt {
    font-weight: 1000;
  }

  .info-row dd {
    margin: 0;
    font-weight: 800;
    color: var(--red);
  }

  .info-row a {
    color: inherit;
  }

  .notes,
  .about,
  .activity {
    position: relative;
    padding: clamp(2rem, 10vw, 4rem) clamp(1rem, 5vw, 4rem);
  }

  .notes-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes-list li {
    position: relative;
    padding: 0.9rem 0 0.9rem 2rem;
    border-bottom: 3px solid var(--black);
    color: var(--red);
    font-weight: 800;
    line-height: 1.6;
  }

  .notes-list li::before {
    content: "";
    position: absolute;
    left: 0.2rem;
    top: 1.4rem;
    width: 0.6rem;
    height: 0.6rem;
    bottom: 0.2rem;
    background: var(--red);
    transform: rotate(46deg);
  }

  .notes-list li:last-child {
    border-bottom: 0;
  }

  .section-title {
    max-width: 900px;
    margin: 0 0 2rem;
    color: var(--red);
    font-size: clamp(3rem, 13vw, 10rem);
    line-height: 0.9;
    font-weight: 1000;
    letter-spacing: -0.08em;
    text-shadow: 12px 12px 0 var(--black);
    transform: rotate(-3deg);
  }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .activity-card {
    min-height: 18rem;
    padding: 1.4rem;
    background: var(--white);
    border: 5px solid var(--black);
    box-shadow: 10px 10px 0 var(--black);
  }

  .activity-card:nth-child(1) {
    transform: rotate(-2deg);
  }

  .activity-card:nth-child(2) {
    transform: rotate(1deg);
  }

  .activity-card:nth-child(3) {
    transform: rotate(-1deg);
  }

  .activity-card:nth-child(4) {
