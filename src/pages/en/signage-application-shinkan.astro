---
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import GenericLayout from '@layouts/GenericLayout.astro';
import Heading from '@components/Heading.astro';
import ContactCard from '@components/ContactCard.astro';
import RoundedButton from '@components/RoundedButton.astro';

import { Image } from 'astro:assets';

import screenImg from '@assets/multi-monitor.png';

const lang = Astro.currentLocale as Lang;
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);

const title = "Would you like to showcase your welcome videos on Taki Plaza’s large screens?";
const description = "We are accepting videos and images that introduce your organization to new students for display on the large monitors (9-screen multi-monitor) located on B2F of Taki Plaza. Applications are open to officially recognized clubs and student organizations of Institute of Science Tokyo.";
---
<GenericLayout title={title} description={description} ListItem={[{ name: 'Signage Applications (Welcome Season)', path: 'signage-application-shinkan' }]}>
    <div class="screen-img-wrapper">
        <Image class="multi-screen" src={screenImg} alt="Taki Plaza 9-screen multi-monitor" />
    </div>

    <Heading title="Examples of Content">
        What kind of club or student organization you are,<br />
        Activities and events throughout the year,<br />
        Plans for welcome events, and more.<br />
        <br />
        If creating a video is difficult, we also accept image submissions, so please feel free to consider this option.
    </Heading>

    <Heading title="Schedule">
        <table class="schedule-table" border="1" cellspacing="0" cellpadding="6">
        <caption>FY2026 Schedule</caption>
        <thead>
            <tr>
            <th>Period</th>
            <th>Application Deadline</th>
            <th>Display Period</th>
            </tr>
        </thead>
        <tbody>
            <tr>
            <td>Welcome Season (Round 1)</td>
            <td>Tue, Mar 17</td>
            <td>Fri, Mar 27 – Fri, May 1</td>
            </tr>
        </tbody>
        </table>
    </Heading>

    <Heading title="How to Apply"> 
        1. First, please review the application guidelines.<br />
        2. Then, fill out the required information in the form and submit it.<br />
        <br />
        <RoundedButton
          label="Application Form"
          href="https://docs.google.com/forms/d/e/1FAIpQLSekVpm9eIK-8ECjf88kReDK26bveictA8dQDYvA1lJaOv0w_Q/viewform?usp=sf_link"
        />
    </Heading>

    <Heading title="Useful Links">
        <ul class="link-list">
            <li>
              <a href="/signage_application.pdf" download="signage_application.pdf">
                Application Guidelines for Taki Plaza 9-Screen Multi-Monitor Signage (Updated: Feb 18, 2025)
              </a>
            </li>
            <li>
              <a target="_blank" href="https://docs.google.com/forms/d/e/1FAIpQLSekVpm9eIK-8ECjf88kReDK26bveictA8dQDYvA1lJaOv0w_Q/viewform?usp=sf_link">
                Video/Image Submission for 9-Screen Display (Google Form)
              </a>
            </li>
            <li>
              <a href="/signage_schedule_2025.pdf" download="signage_schedule_2025.pdf">
                FY2025 Display Schedule
              </a>
            </li>
        </ul>
    </Heading>

    <Heading title="FAQ">
        <ul class="link-list">
            <li>Can unrecognized organizations apply?</li>
            To prevent issues, we only accept applications from officially recognized clubs of Institute of Science Tokyo and student organizations supported by on-campus bodies.
            Unrecognized organizations and individuals may apply for use of the
            <a href={translatePath('/poster-application/')}> student bulletin board</a> on B2F of Taki Plaza.

            <li>Can we display multiple videos?</li>
            Each organization is limited to one video per period. Thank you for your understanding.

            <li>We want to display a longer video.</li>
            To avoid overly long content, we ask that videos be kept within one minute (within 30 seconds during the welcome season).
            If it is difficult to meet this requirement, please contact the Taki Plaza Gardener Management Team by email to discuss individually.

            <li>Can we request a limited display period?</li>
            Videos will be displayed according to the schedules prepared by us. As a general rule, exceptions are not permitted.

            <li>Can we display the same content across multiple periods?</li>
            If you wish to display content across multiple periods, please submit the same file during the application period for each relevant slot.

            <li>Can officially recognized medical or dental clubs apply?</li>
            Yes. Any officially recognized club of Institute of Science Tokyo, including medical and dental clubs, is eligible to apply.
        </ul>
        <p class="link-list">
          For information on using the student bulletin board on B2F of Taki Plaza, please see
          <a href={translatePath('/poster-application/')}> this page</a>.
        </p>
    </Heading>

    <ContactCard department="Taki Plaza Gardener Management Team" email="takiplazagardener.management@gmail.com" />
</GenericLayout>


<style>
    .screen-img-wrapper {
        margin: 20px 0 0;
    }

    .multi-screen {
        width: 100%;
        max-height: 100%;
        height: auto;
        margin: 0;
        border-radius: 10px;
    }

    .link-list {
        padding-left: 1.5em;
        font-family: 'Noto Sans JP Variable', sans-serif;
		color: #000;
    }

    .link-list li {
        margin-bottom: 10px;
    }

    .schedule-table {
        border-collapse: collapse;
        width: 100%;
        max-width: 600px;
        margin: 1em auto;
        font-family: 'Noto Sans JP Variable', sans-serif;
		color: #000;
        font-size: 14px;
    }

    .schedule-table caption {
        margin-bottom: 0.5em;
        font-size: 16px;
        text-align: left;
    }

    .schedule-table th, .schedule-table td {
        border: 1px solid #ccc;
        padding: 0.6em 0.8em;
        text-align: center;
    }

    .schedule-table th {
        background-color: #f0f0f0;
    }

    .schedule-table tr:nth-child(even) {
        background-color: #fafafa;
    }

    /* モバイル用のCSS */
    @media screen and (max-width: 768px) {
        .screen-img-wrapper {
            margin: 20px 5% 0;
            width: 90%;
        }

        .link-list {
            font-size: 12px;
            letter-spacing: 0.8px;
            line-height: 200%;
        }
    }

    /* デスクトップ用のCSS */
    @media screen and (min-width: 769px) {
        .screen-img-wrapper {
            margin: 20px 20% 0;
            width: 60%;
        }

        .link-list {
            font-size: 16px;
            letter-spacing: 1.2px;
            line-height: 200%;
        }
    }
</style>