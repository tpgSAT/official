---
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import GenericLayout from '@layouts/GenericLayout.astro';
import Heading from '@components/Heading.astro';
import ContactCard from '@components/ContactCard.astro';
import Slider from '@components/TeamsSlider.astro'
import RoundedButton from '@components/RoundedButton.astro';
import ArticleImage from '@components/ArticleImage.astro';

import ClubRetreatImg from '@assets/about/club-retreat.jpg';
import TpgLogo from '@assets/about/tpg-logo.png';

const lang = Astro.currentLocale as Lang;
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);

const title = "TPGについて";
const description = "Taki Plaza Gardener(以下TPG)は、東京科学大学に存在する国際交流と学⽣⽀援を⽬的とする施設であるHisao & Hiroko Taki Plazaでの、学⽣による活発な利⽤を促すことを⽬的として活動しています。";
---
<GenericLayout title={title} description={description} ListItem={[{ name: 'TPGについて', path: 'about' }]}>
    <Heading title="活動内容">
        TPGは年間を通してさまざまなイベントを企画・運営しています。 中でも、新入生向けの学内最大級の学生交流イベントである若葉祭を毎年開催してきました。 その他、留学生の参加者も多いTakiBarや音楽系サークルに発表を行ってもらうTakiFes、少人数でボードゲームを制作するボドゲ制作会、折り紙企画などを行ってきました。 これまでのイベントについては<a href={translatePath('/events/')}>こちら</a>をご覧ください。
        <br /><br />
        76名(2025.07現在)のメンバーが所属し、イベント班・コミュニティ班・制作班・マネジメント班・システム班の5つの班に分かれて活動しています。学士3年生以下の東京科学大学生で構成されており、留学生も所属しています。 活動は週1で、活動拠点となるTakiPlaza地下2階の居室では日頃から誰かしらが居てにぎやかに過ごしています。
        <ArticleImage src={TpgLogo} alt="TPGのロゴ" />
    </Heading>
    <Heading title="班の活動">
        TPGはイベント班・コミュニティ班・制作班・マネジメント班・システム班の5つの班に分かれて活動しています。それぞれの班については以下からご確認ください。
        <Slider />
    </Heading>
    <Heading title="遊び">
        TPGではメンバーが班や学年を超えて交流できるように「組活動」、「懇親会」や「合宿」などのイベントを定期的に開催しています。
        <br />
        組活動では毎クォーターごとに異なるメンバーで様々なアクティビティを楽しんでいます。例えば昼休みに大岡山周辺のパン屋さんを巡ったり、日帰りで旅行に行ったりと幅広い活動を行っています。
        また、毎年夏には2泊3日の合宿を行っており、今年は静岡県の伊東に行きました。BBQパーティーや花火、ビンゴ大会などを通じてメンバー同士の親睦を深めることができました。
        懇親会としては、学年ごとの懇親会や全体での懇親会をマネジメント班が中心となって企画・開催しています。謎解き企画に参加したり、お台場でピクニックをしたりと、楽しい企画が盛りだくさんです。
        <br />
        ここで紹介した以外にも、TPGでは班での遊びや個人的に人を集めて行く遊びもたくさんあります。
        各班の紹介ページもぜひご覧ください！
        <ArticleImage src={ClubRetreatImg} alt="合宿の様子" />
    </Heading>
    <Heading title="入会">
        TPGでは常時メンバーを募集しています。興味のある方は以下のページをご覧ください。
        <div id="button-wrapper">
            <RoundedButton label="入会について" href={translatePath('/join/')} />
        </div>
    </Heading>
    <ContactCard />
</GenericLayout>

<style>
    #button-wrapper {
        text-align: center;
    }
</style>