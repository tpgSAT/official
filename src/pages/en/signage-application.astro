---
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import GenericLayout from '@layouts/GenericLayout.astro';
import Heading from '@components/Heading.astro';
import ContactCard from '@components/ContactCard.astro';
import RoundedButton from '@components/RoundedButton.astro';

import { Image } from 'astro:assets';

import ShinkanPopup from '@components/ShinkanPopup.astro';

import screenImg from '@assets/multi-monitor.png';


const lang = Astro.currentLocale as Lang;
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);

const title = "Show Your Videos on Taki Plaza’s Large Screens!";
const description = "We are accepting videos and images that introduce your organization for display on the large 9-screen monitor in Taki Plaza B2F. Applications are open to officially recognized clubs and student organizations at the Institute of Science Tokyo.";
---
<GenericLayout title={title} description={description} ListItem={[{ name: 'Signage Applications', path: 'signage-application' }]}>
    <div class="screen-img-wrapper">
        <Image class="multi-screen" src={screenImg} alt="Taki Plaza 9-screen multi-monitor" />
    </div>

    <Heading title="Example Content">
        Show what your club or organization usually does!<br />
        Promote events you are hosting! Come join us!<br />
        Share your competition results! Here's what happened!<br />
        <br />
        If making a video is difficult, we also accept image submissions. Please consider this option as well.
    </Heading>

    <Heading title="Schedule">
        <table class="schedule-table" border="1" cellspacing="0" cellpadding="6">
        <caption>2025 Schedule</caption>
        <thead>
            <tr>
            <th>Period</th>
            <th>Application Deadline</th>
            <th>Display Period</th>
            </tr>
        </thead>
        <tbody>
            <tr>
            <td>Period 1</td>
            <td>Mon, Apr 21</td>
            <td>Sat, May 3 – Tue, Jun 17</td>
            </tr>
            <tr>
            <td>Period 2</td>
            <td>Mon, Jun 9</td>
            <td>Wed, Jun 18 – Tue, Aug 5</td>
            </tr>
            <tr>
            <td>Period 3</td>
            <td>Mon, Sep 22</td>
            <td>Wed, Oct 1 – Tue, Nov 4</td>
            </tr>
            <tr>
            <td>Period 4</td>
            <td>Mon, Oct 27</td>
            <td>Wed, Nov 5 – Tue, Dec 23</td>
            </tr>
            <tr>
            <td>Period 5</td>
            <td>Mon, Dec 15</td>
            <td>Wed, Dec 24 – Sat, Feb 7</td>
            </tr>
        </tbody>
        </table>
    </Heading>

    <Heading title="How to Apply"> 
        1. First, please review the application guidelines.<br />
        2. Fill out the required information in the form and submit it.<br />
        <br />
        <RoundedButton label="Application Form" href="https://docs.google.com/forms/d/e/1FAIpQLSekVpm9eIK-8ECjf88kReDK26bveictA8dQDYvA1lJaOv0w_Q/viewform?usp=sf_link" />
    </Heading>

    <Heading title="Useful Links">
        <ul class="link-list">
            <li><a href="/signage_application.pdf" download="signage_application.pdf">Taki Plaza 9-Screen Multi-Monitor Signage Application Guidelines (Updated: Feb 18, 2025)</a></li>
            <li><a target="_blank" href="https://docs.google.com/forms/d/e/1FAIpQLSekVpm9eIK-8ECjf88kReDK26bveictA8dQDYvA1lJaOv0w_Q/viewform?usp=sf_link">Submit Your 9-Screen Video/Image (Google Form)</a></li>
            <li><a href="/signage_schedule_2025.pdf" download="signage_schedule_2025.pdf">2025 Display Schedule</a></li>
        </ul>
    </Heading>

    <Heading title="FAQ">
        <ul class="link-list">
            <li>Can unrecognized organizations apply?</li>
            For safety reasons, we only accept applications from officially recognized clubs and student organizations supported by on-campus groups.
            However, unrecognized organizations and individuals may use the <a href={translatePath('/poster-application/')}>student bulletin board</a> on B2F of Taki Plaza.
            
            <li>Can we display multiple videos?</li>
            Only one video per organization can be displayed at the same time. Thank you for your understanding.

            <li>We want to show a longer video!</li>
            To avoid overly long content, we ask that videos be within 1 minute (within 30 seconds during the welcome season). 
            If longer videos are necessary, please contact the Taki Plaza Gardener Management Team by email.

            <li>Can we request a limited display period?</li>
            Videos will be displayed according to the schedule we provide. Exceptions are generally not allowed.

            <li>Can we display the same content across multiple periods?</li>
            If you want to display content across multiple periods, submit the same file during each relevant application period.

            <li>Can officially recognized medical or dental clubs apply?</li>
            Yes. Any officially recognized club at the Institute of Science Tokyo, including medical or dental clubs, may apply.
        </ul>
        <p class="link-list">For information on using the student bulletin board on B2F of Taki Plaza, see <a href={translatePath('/poster-application/')}>this page</a>.</p>
    </Heading>

    <ContactCard department="Taki Plaza Gardener Management Team" email="takiplazagardener.management@gmail.com" />

    <ShinkanPopup />
</GenericLayout>

<style>
    .screen-img-wrapper {
        margin: 20px 0 0;
    }

    .multi-screen {
        width: 100%;
        max-height: 100%;
        height: auto;
        margin: 0;
        border-radius: 10px;
    }

    .link-list {
        padding-left: 1.5em;
        font-family: 'Noto Sans JP Variable', sans-serif;
        color: #000;
    }

    .link-list li {
        margin-bottom: 10px;
    }

    .schedule-table {
        border-collapse: collapse;
        width: 100%;
        max-width: 600px;
        margin: 1em auto;
        font-family: 'Noto Sans JP Variable', sans-serif;
        color: #000;
        font-size: 14px;
    }

    .schedule-table caption {
        margin-bottom: 0.5em;
        font-size: 16px;
        text-align: left;
    }

    .schedule-table th, .schedule-table td {
        border: 1px solid #ccc;
        padding: 0.6em 0.8em;
        text-align: center;
    }

    .schedule-table th {
        background-color: #f0f0f0;
    }

    .schedule-table tr:nth-child(even) {
        background-color: #fafafa;
    }

    @media screen and (max-width: 768px) {
        .screen-img-wrapper {
            margin: 20px 5% 0;
            width: 90%;
        }

        .link-list {
            font-size: 12px;
            letter-spacing: 0.8px;
            line-height: 200%;
        }
    }

    @media screen and (min-width: 769px) {
        .screen-img-wrapper {
            margin: 20px 20% 0;
            width: 60%;
        }

        .link-list {
            font-size: 16px;
            letter-spacing: 1.2px;
            line-height: 200%;
        }
    }
</style>
