---
import { getCollection } from 'astro:content';
import NewsCard from '@components/NewsCard.astro';

import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const newsEntries = await getCollection('news');

const ListItem = [
  { path: 'news', name: 'お知らせ' },
];
---

<Layout title="News">
    <Breadcrumb lists={ListItem} />
    <div id="root">
        <h1>お知らせ</h1>
        {[...newsEntries]
            .sort((a, b) => new Date(b.data.date) - new Date(a.data.date)) // 日付で降順ソート
            .map(news => (
                <NewsCard news={news} />
        ))}
    </div>
</Layout>

<style>
    #root {
        margin: 0 5vw 40px;
    }

    #root h1 {
        font-family: 'Midashi Go MB31', 'Noto Sans JP Variable', sans-serif;
        font-size: 28px;
        letter-spacing: 2px;
        font-weight: 500;
    }
</style>