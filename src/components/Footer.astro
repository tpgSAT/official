---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import { Image } from 'astro:assets';
import logo from '@assets/header/logo_with_text.png';

import iconX from '@assets/footer/icon_x.svg';
import iconInstagram from '@assets/footer/icon_instagram.svg';
import about from '@assets/footer/about.svg';
import aboutEn from '@assets/footer/about_en.svg';
import blog from '@assets/footer/blog.svg';
import blogEn from '@assets/footer/blog_en.svg';
import contact from '@assets/footer/contact.svg';
import contactEn from '@assets/footer/contact_en.svg';
import events from '@assets/footer/events.svg';
import eventsEn from '@assets/footer/events_en.svg';
import bulletinBboard from '@assets/footer/bulletin_board.svg';
import bulletinBboardEn from '@assets/footer/bulletin_board_en.svg';
import multiScreen from '@assets/footer/multi_screen.svg';
import multiScreenEn from '@assets/footer/multi_screen_en.svg';


const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);
---

<footer>
    <div id="footer-top-wrapper">
        <Image src={logo} alt="TPG Logo" width="120" class="logo" />
        <div id="social-media">
            <a href="https://x.com/TPGardener/"><Image src={iconX} alt="X" /></a>
            <a href="https://www.instagram.com/taki_plaza_gardener/"><Image src={iconInstagram} alt="Instagram"/></a>
        </div>
    </div>
    
    <div id="footer-nav">
        <a href={translatePath('/about/')}><Image id="about" src={t({ ja: about, en: aboutEn })} alt="About" /></a>
        <a href={translatePath('/events/')}><Image id="events" src={t({ ja: events, en: eventsEn })} alt="Events" /></a>
        <a href={translatePath('/blog/')}><Image id="blog" src={t({ ja: blog, en: blogEn })} alt="Blog" /></a>
        <a href={translatePath('/poster-application/')}><Image id="bulletin-board" src={t({ ja: bulletinBboard, en: bulletinBboardEn })} alt="Poster Application" /></a>
        <a href={translatePath('/signage-application/')}><Image id="multi-screen" src={t({ ja: multiScreen, en: multiScreenEn })} alt="Signage Application" /></a>
        <a href={translatePath('/contact/')}><Image id="contact" src={t({ ja: contact, en: contactEn })} alt="Contact" /></a>
    </div>
    <p id="copyright">©︎ {new Date().getFullYear()} Taki Plaza Gardener All Rights Reserved.</p>
</footer>

<style>
    footer {
        width: 100%;
        background-color: #1F1F1F;
        padding: 20px 0;
    }

    a {
        text-decoration: none;
    }

    #footer-top-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin: 20px 8vw;
    }

    #social-media {
        display: flex;
        gap: 20px;
    }

    #footer-nav {
        display: grid;
        grid-template-columns: 50% 50%;
        grid-template-rows: repeat(3, 40px);
        margin: 40px 8vw;
    }

    #footer-nav #about{ grid-area: 1 / 1 / 2 / 2; }

    #footer-nav #events{ grid-area: 2 / 1 / 3 / 2; }

    #footer-nav #blog{ grid-area: 3 / 1 / 4 / 2; }

    #footer-nav #bulletin-board{ grid-area: 1 / 2 / 2 / 3; }

    #footer-nav #multi-screen{ grid-area: 2 / 2 / 3 / 3; }

    #footer-nav #contact{ grid-area: 3 / 2 / 4 / 3; }

    #copyright {
        text-align: center;
        font-family: 'Noto Sans JP Variable', sans-serif;
        font-weight: 400;
        font-size: 12px;
        color: #FFF;
        margin-top: 20px;
    }
</style>