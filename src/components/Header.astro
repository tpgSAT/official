---
// Astroの画像最適化を利用するため
import { Image } from 'astro:assets';
import logo from '../assets/header/logo_with_text.png';
import headerNavEvents from '../assets/header/header_nav_events.svg';
import headerNavNews from '../assets/header/header_nav_news.svg';
import headerNavBlog from '../assets/header/header_nav_blog.svg';
import headerNavContact from '../assets/header/header_nav_contact.svg';
import iconX from '../assets/header/icon_x.svg';
import iconInstagram from '../assets/header/icon_instagram.svg';
---

<header>
    <Image src={logo} alt="TPG Logo" width="120" class="logo" />
    <button class="hamburger" id="js-hamburger">
        <span></span>
        <span></span>
        <span></span>
    </button>
    
    <div class="header_nav" id="js-nav">
        <nav>
            <ul>
                <li><a href="/events/"><Image src={headerNavEvents} alt="Events" /></a></li>
                <li><a href="/news/"><Image src={headerNavNews} alt="News" /></a></li>
                <li><a href="/blog/"><Image src={headerNavBlog} alt="Blog" /></a></li>
                <li><a href="/contact/"><Image src={headerNavContact} alt="Contact" /></a></li>
            </ul>
            <div class="social-media">
                <a href="https://x.com/TPGardener/"><Image src={iconX} alt="X" /></a>
                <a href="https://www.instagram.com/taki_plaza_gardener/"><Image src={iconInstagram} alt="Instagram"/></a>
            </div>
        </nav>
    </div>
</header>

<style>
	header {
		position: fixed;
        top: 0;
        left: 0;
        width: 100%;
		padding: 0 10px;
		height: 80px;
		display: flex;
		align-items: center;
		z-index: 999;
        background-color: #fff;
	}

	.logo {

	}

	.header_nav {
		position: fixed;
		overflow: hidden;
		right: 5px;
		top: 5px;
		background-color: #fff;
		transition: ease .4s;
		width: 60px;
		height: 60px;
		border-radius: 20px;
		border: 1px solid #000;
		opacity: 0;
		z-index: 1000;
	}

	.header_nav.open nav{
		margin: 50px 0 10px;
	}

	.header_nav ul, .header_nav li {
  		list-style: none;
	}

	.header_nav ul {
		padding: 0 20px;
	}

	.header_nav li {
		padding:5px 0;
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.4s ease, transform 0.4s ease;
	}

	.header_nav.open li {
		opacity: 1;
		transform: translateY(0);
	}

    .social-media {
        display: flex;
        justify-content: flex-start;
        padding: 10px 20px;
        gap: 10px;
    }

    .social-media a {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .header_nav.open .social-media a {
        opacity: 1;
        transform: translateY(0);
    }

	.header_nav.open li:nth-child(1) { transition-delay: 0.1s; }
	.header_nav.open li:nth-child(2) { transition-delay: 0.2s; }
	.header_nav.open li:nth-child(3) { transition-delay: 0.3s; }
	.header_nav.open li:nth-child(4) { transition-delay: 0.4s; }
    .header_nav.open .social-media a{ transition-delay: 0.4s; }

	.header_nav.open {
		width: 200px;
		height: 300px;
		opacity: 1;
	}

	.hamburger {
		position: absolute;
		right: 10px;
		top: 0;
		background-color: transparent;
		border-color: transparent;
		z-index: 9999;
		width: 50px;
  		height: 100%;
		padding: 16px 20px 16px 0px;
	}

	.hamburger span {
		width: 100%;
		height: 1px;
		background-color: #000;
		position: relative;
		transition: ease .4s;
		display: block;
	}

	.hamburger span:nth-child(1) {
		top: 0;
	}

	.hamburger span:nth-child(2) {
		margin: 8px 0;
	}

	.hamburger span:nth-child(3) {
		top: 0;
	}

	.hamburger.active span:nth-child(1) {
		top: 5px;
		transform: rotate(45deg);
	}

	.hamburger.active span:nth-child(2) {
		opacity: 0;
	}

	.hamburger.active span:nth-child(3) {
		top: -13px;
		transform: rotate(-45deg);
	}
</style>

<script>
	const ham = document.querySelector('#js-hamburger');
	const nav = document.querySelector('#js-nav');

	ham?.addEventListener('click', function () {

		ham?.classList.toggle('active');
		nav?.classList.toggle('open');

	});
</script>