---
import { useTranslations, generateLocalePaths } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Astroの画像最適化を利用するため
import { Image } from 'astro:assets';
import logo from '@assets/header/logo_with_text.png';
import events from '@assets/header/events.svg';
import news from '@assets/header/news.svg';
import blog from '@assets/header/blog.svg';
import contact from '@assets/header/contact.svg';
import iconX from '@assets/header/icon_x.svg';
import iconInstagram from '@assets/header/icon_instagram.svg';
import switchLang from '@assets/header/switch_lang_en.svg';

import eventsEn from '@assets/header/events_en.svg';
import newsEn from '@assets/header/news_en.svg';
import blogEn from '@assets/header/blog_en.svg';
import contactEn from '@assets/header/contact_en.svg';
import switchLangEn from '@assets/header/switch_lang_ja.svg';

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);

const locales = generateLocalePaths(Astro.url);
const jaLocale = locales.find((locale) => locale.lang === 'ja');
const enLocale = locales.find((locale) => locale.lang === 'en');
---

<header>
	<a href={translatePath('/')}><Image src={logo} alt="TPG Logo" width="120" class="logo" /></a>
    <button class="hamburger" id="js-hamburger">
        <span></span>
        <span></span>
        <span></span>
    </button>
    
    <div class="header_nav" id="js-nav">
        <nav>
            <ul>
                <li><a href={translatePath('/events/')}><Image src={t({ ja: events, en: eventsEn })} alt="Events" /></a></li>
                <li><a href={translatePath('/news/')}><Image src={t({ ja: news, en: newsEn })} alt="News" /></a></li>
                <li><a href={translatePath('/blog/')}><Image src={t({ ja: blog, en: blogEn })} alt="Blog" /></a></li>
                <li><a href={translatePath('/contact/')}><Image src={t({ ja: contact, en: contactEn })} alt="Contact" /></a></li>
                <li><a href={t({ ja: enLocale?.path || '/', en: jaLocale?.path || '/' })}><Image src={t({ ja: switchLang, en: switchLangEn })} alt="Switch Language" /></a></li>
            </ul>
            <div class="social-media">
                <a href="https://x.com/TPGardener/"><Image src={iconX} alt="X" /></a>
                <a href="https://www.instagram.com/taki_plaza_gardener/"><Image src={iconInstagram} alt="Instagram"/></a>
            </div>
        </nav>
    </div>
</header>

<style>
	header {
		position: fixed;
        top: 0;
        left: 0;
        width: 100%;
		padding: 0 10px;
		height: 80px;
		display: flex;
		align-items: center;
		z-index: 999;
        background-color: #fff;
	}

	a {
        text-decoration: none;
    }

	.logo {

	}

	.header_nav {
		position: fixed;
		overflow: hidden;
		right: 5px;
		top: 5px;
		background-color: #fff;
		transition: ease .4s;
		width: 60px;
		height: 60px;
		border-radius: 20px;
		border: 1px solid #000;
		opacity: 0;
		z-index: 1000;
	}

	.header_nav.open nav{
		margin: 50px 0 10px;
	}

	.header_nav ul, .header_nav li {
  		list-style: none;
	}

	.header_nav ul {
		padding: 0 20px;
	}

	.header_nav li {
		padding:5px 0;
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.4s ease, transform 0.4s ease;
	}

	.header_nav.open li {
		opacity: 1;
		transform: translateY(0);
	}

    .social-media {
        display: flex;
        justify-content: flex-start;
        padding: 10px 20px;
        gap: 10px;
    }

    .social-media a {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .header_nav.open .social-media a {
        opacity: 1;
        transform: translateY(0);
    }

	.header_nav.open li:nth-child(1) { transition-delay: 0.1s; }
	.header_nav.open li:nth-child(2) { transition-delay: 0.2s; }
	.header_nav.open li:nth-child(3) { transition-delay: 0.3s; }
	.header_nav.open li:nth-child(4) { transition-delay: 0.4s; }
	.header_nav.open li:nth-child(5) { transition-delay: 0.5s; }
    .header_nav.open .social-media a{ transition-delay: 0.5s; }

	.header_nav.open {
		width: 200px;
		height: 300px;
		opacity: 1;
	}

	.hamburger {
		position: absolute;
		right: 10px;
		top: 0;
		background-color: transparent;
		border-color: transparent;
		z-index: 9999;
		width: 50px;
  		height: 100%;
		padding: 16px 20px 16px 0px;
	}

	.hamburger span {
		width: 100%;
		height: 1px;
		background-color: #000;
		position: relative;
		transition: ease .4s;
		display: block;
	}

	.hamburger span:nth-child(1) {
		top: 0;
	}

	.hamburger span:nth-child(2) {
		margin: 8px 0;
	}

	.hamburger span:nth-child(3) {
		top: 0;
	}

	.hamburger.active span:nth-child(1) {
		top: 5px;
		transform: rotate(45deg);
	}

	.hamburger.active span:nth-child(2) {
		opacity: 0;
	}

	.hamburger.active span:nth-child(3) {
		top: -13px;
		transform: rotate(-45deg);
	}
</style>

<script>
	const ham = document.querySelector('#js-hamburger');
	const nav = document.querySelector('#js-nav');

	ham?.addEventListener('click', function () {

		ham?.classList.toggle('active');
		nav?.classList.toggle('open');

	});
</script>