---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
    news: any;
}

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);

const { news } = Astro.props as Props;
---

<a href={translatePath(`/news/${ news.slug}`)}>
    <div class="content">
        <p class="date">
            {news.data.date.toLocaleDateString('ja-JP', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
            }).replace(/\//g, '.')}
        </p>
        <p class="type">{news.data.tags.join(' ')}</p>
        <h3 class="title">{news.data.title}</h3>
    </div>
</a>

<style>
	a {
        text-decoration: none;
    }
	
    .content {
        font-family: 'Noto Sans JP Variable', sans-serif;
		padding: 5px;
		border-bottom: 1px solid #B8B8B8;
	}

	.date, .type{
		font-weight: 500;
		font-size: 10px;
		letter-spacing: 0.4px;
		color: #000;
		margin: 0 16px 0 0;
		display: inline-block;
		position: relative;
	}

	.type::before {
		content: "";
		background-color: #A6A6A6;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		position: absolute;
		left: -14px;
		top: 50%;
		transform: translateY(-50%);
	}

	.title {
		font-weight: 500;
		font-size: 15px;
		margin: 12px 0;
	}
</style>