---
const TARGET_PATH = "/signage-application/";
const SHINKAN_URL = "/signage-application-test/";
const pathname = Astro.url.pathname;
const shouldShow = pathname === TARGET_PATH;
---

{shouldShow && (
  <div id="shinkan-overlay">
    <div id="shinkan-popup">
      <p class="title">新歓ページがあります</p>
      <p class="text">新歓用の案内ページへ移動しますか？</p>

      <div class="buttons">
        <button id="go" data-url={SHINKAN_URL}>今すぐ移動</button>
        <button id="stay">移動しない</button>
      </div>
    </div>
  </div>
)}

<script>
  const goBtn = document.getElementById("go");
  const stayBtn = document.getElementById("stay");
  const overlay = document.getElementById("shinkan-overlay");

  if (goBtn && stayBtn && overlay) {
    goBtn.addEventListener("click", () => {
      const url = goBtn.dataset.url;
      if (url) {
        window.location.href = url;
      }
    });

    stayBtn.addEventListener("click", () => {
      overlay.remove();
    });
  }
</script>

<style>
  #shinkan-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #shinkan-popup {
    background: #fff;
    padding: 24px;
    border-radius: 8px;
    width: min(90%, 360px);
    text-align: center;
  }

  .title {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 8px;
  }

  .text {
    font-size: 14px;
    margin-bottom: 16px;
  }

  .buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  button {
    padding: 8px 16px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
  }

  #go {
    background: #0070f3;
    color: #fff;
  }

  #stay {
    background: #ccc;
  }
</style>
