---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);

const TARGET_PATH = translatePath("/signage-application/"); // ポップアップを表示するページ
const SHINKAN_URL = translatePath("/signage-application-shinkan/"); // 移動先のページ
const pathname = Astro.url.pathname;
const shouldShow = pathname === TARGET_PATH;
---

{shouldShow && (
  <div id="shinkan-overlay">
    <div id="shinkan-popup">
      <p class="title">{t({ ja: "新歓向けのサイネージ募集ページがあります", en: "There is a signage application page for new students", })}</p>
      <div class="buttons">
        <button id="go" data-url={SHINKAN_URL}>{t({ ja: "今すぐ移動", en: "Go Now", })}</button>
        <button id="stay">{t({ ja: "移動しない", en: "Stay", })}</button>
      </div>
    </div>
  </div>
)}

<script>
  const goBtn = document.getElementById("go");
  const stayBtn = document.getElementById("stay");
  const overlay = document.getElementById("shinkan-overlay");

  if (goBtn && stayBtn && overlay) {
    goBtn.addEventListener("click", () => {
      const url = goBtn.dataset.url;
      if (url) {
        window.location.href = url;
      }
    });

    stayBtn.addEventListener("click", () => {
      overlay.remove();
    });
  }
</script>

<style>
  a {
    text-decoration: none;
  }

  #shinkan-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #shinkan-popup {
    background: #fff;
    padding: 24px;
    border-radius: 24px;
    border: 1px solid black;
    width: min(90%, 360px);
    text-align: center;
    font-family: "Noto Sans JP Variable", sans-serif;
  }

  .title {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 20px;
  }

  .buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  button {
    padding: 8px 16px;
    border-radius: 20px;
    border: none;
    cursor: pointer;
    font-size: 12px;
  }

  #go {
    background: #87F99B;
    color: #000;
  }

  #stay {
    background: #ccc;
  }
</style>
