---
import { Image } from 'astro:assets';

import SignageBannerImg from '@assets/banner/signage_banner.png';
import PosterBannerImg from '@assets/banner/poster_banner.png';
---

<div class="banner-wrapper">
    <a href="/signage-application/">
        <Image class="banner" src={SignageBannerImg} alt="Taki Plazaの大画面で映像を流しませんか？" />
    </a>
    <a href="/poster-application/">
        <Image class="banner" src={PosterBannerImg} alt="掲示板でサークルやイベントを紹介しませんか？" />
    </a>
</div>

<style>
    /* モバイル用のCSS */
    @media screen and (max-width: 768px) {
        .banner-wrapper {
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
        }

        .banner {
            width: 100%;
            height: auto;
            margin: 20px 0;
            max-width: 500px;
        }
    }

    /* デスクトップ用のCSS */
    @media screen and (min-width: 769px) {
        .banner-wrapper {
            display: flex;
            gap: 20px;
            justify-content: space-around;
        }

        .banner {
            width: 100%;
            height: auto;
            margin: 20px 0;
            max-width: 500px;
        }
    }
</style>
