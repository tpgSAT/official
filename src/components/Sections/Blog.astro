---
import TopPageSection from '@layouts/TopPageSection.astro';

import { Image } from 'astro:assets';
import headingBlog from '@assets/topPage/heading_blog.svg';
import blogThumbnail from '@assets/topPage/blog_thumbnail.png';
---

<TopPageSection headingSVG={headingBlog}>
    <a href="#">
		<div class="blog-content">
			<Image src={blogThumbnail} class="blog-thumbnail" alt="Blog Thumbnail" />
			<div class="blog-tags"><p class="blog-tag">新歓ブログリレー</p></div>
			<h3 class="blog-title">TPG班紹介！！～システム班～</h3>
			<p class="blog-date">2025.4.11</p>
		</div>
	</a>
	<a href="#">
		<div class="blog-content">
			<Image src={blogThumbnail} class="blog-thumbnail" alt="Blog Thumbnail" />
			<div class="blog-tags"><p class="blog-tag">新歓ブログリレー</p></div>
			<h3 class="blog-title">TPG班紹介！！～システム班～</h3>
			<p class="blog-date">2025.4.11</p>
		</div>
	</a>
	<a href="#">
		<div class="blog-content">
			<Image src={blogThumbnail} class="blog-thumbnail" alt="Blog Thumbnail" />
			<div class="blog-tags"><p class="blog-tag">新歓ブログリレー</p></div>
			<h3 class="blog-title">TPG班紹介！！～システム班～</h3>
			<p class="blog-date">2025.4.11</p>
		</div>
	</a>
	<a href="#">
		<div class="blog-content">
			<Image src={blogThumbnail} class="blog-thumbnail" alt="Blog Thumbnail" />
			<div class="blog-tags"><p class="blog-tag">新歓ブログリレー</p></div>
			<h3 class="blog-title">TPG班紹介！！～システム班～</h3>
			<p class="blog-date">2025.4.11</p>
		</div>
	</a>
</TopPageSection>

<style>
    .blog-content {
        font-family: 'Noto Sans JP Variable', sans-serif;
		padding: 15px 0 0;
		display: grid;
		grid-template-columns: 40% 1fr;
		grid-template-rows: 20px 1fr 20px;
		gap: 0 10px;
	}

	.blog-thumbnail {
		width: 100%;
		height: auto;
		border-radius: 10px;
		grid-column: 1 / 2;
		grid-row: 1 / 4;
	}

	.blog-tags, .blog-date{
		font-weight: 400;
		font-size: 10px;
		letter-spacing: 0.4px;
		color: #707070;
		margin: 0;
		display: inline-block;
		grid-column: 2 / 3;
	}

	.blog-title {
		font-weight: 500;
		font-size: 14px;
		margin: 0;
		padding: 0;
		grid-column: 2 / 3;
		grid-row: 2 / 3;
	}

	.blog-tags {
		grid-row: 1 / 2;
	}

	.blog-tag {
		padding: 0;
		margin: 0;
	}

	.blog-date {
		grid-row: 3 / 4;
	}
</style>