---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import TopPageSection from '@layouts/TopPageSection.astro';
import BlogCard from '@components/BlogCard.astro';
import { getPosts } from '@lib/api';
import { Image } from 'astro:assets';
import headingBlog from '@assets/topPage/heading_blog.svg';

import linkToBlog from '@assets/topPage/link_to_blog.svg';
import linkToBlogEn from '@assets/topPage/link_to_blog_en.svg';

const posts = await getPosts();

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);
---

<TopPageSection headingSVG={headingBlog}>
	<div class="blog-content-wrapper">
    {[...posts].slice(0, 3).map(post => <BlogCard post={post} />)}
	</div>

    <div class="link-wrapper">
        <a href={translatePath('/blog/')}>
            <Image src={t({ja: linkToBlog, en: linkToBlogEn})} alt={t({ja: "ブログ一覧", en: "Blog List"})} class="link-img" />
        </a>
    </div>
</TopPageSection>

<style>
	.link-wrapper {
        display: flex;
        justify-content: flex-end;
    }

    .link-img {
        display: block;
        margin: 0 auto 0;
        width: auto;
    }
    /* デスクトップ用のCSS */
    @media screen and (min-width: 769px) {
		.blog-content-wrapper {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: flex-start;
			margin: 20px 0 0;
		}
    }
</style>