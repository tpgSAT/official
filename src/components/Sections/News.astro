---
import TopPageSection from '@layouts/TopPageSection.astro';

import headingNews from '@assets/topPage/heading_news.svg';
---

<TopPageSection headingSVG={headingNews}>
    <a href="#">
        <div class="news-content">
            <p class="news-date">2025.4.11</p>
            <p class="news-type">イベント開催報告</p>
            <h3 class="news-title">「絵しりとりコンテスト」を開催しました</h3>
        </div>
    </a>
    <a href="#">
        <div class="news-content">
            <p class="news-date">2025.4.11</p>
            <p class="news-type">イベント開催報告</p>
            <h3 class="news-title">「絵しりとりコンテスト」を開催しました</h3>
        </div>
    </a>
    <a href="#">
        <div class="news-content">
            <p class="news-date">2025.4.11</p>
            <p class="news-type">イベント開催報告</p>
            <h3 class="news-title">「絵しりとりコンテスト」を開催しました</h3>
        </div>
    </a>
</TopPageSection>

<style>
    .news-content {
        font-family: 'Noto Sans JP Variable', sans-serif;
		padding: 5px;
		border-bottom: 1px solid #B8B8B8;
	}

	.news-date, .news-type{
		font-weight: 500;
		font-size: 10px;
		letter-spacing: 0.4px;
		color: #000;
		margin: 0 16px 0 0;
		display: inline-block;
		position: relative;
	}

	.news-type::before {
		content: "";
		background-color: #A6A6A6;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		position: absolute;
		left: -14px;
		top: 50%;
		transform: translateY(-50%);
	}

	.news-title {
		font-weight: 500;
		font-size: 15px;
		margin: 12px 0;
	}
</style>