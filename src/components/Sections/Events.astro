---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import TopPageSection from '@layouts/TopPageSection.astro';
import Slider from '@components/EventsSlider.astro';
import { Image } from 'astro:assets';

import linkToEvents from '@assets/topPage/link_to_events.svg';
import headingEvents from '@assets/topPage/heading_events.svg';

import linkToEventsEn from '@assets/topPage/link_to_events_en.svg';

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);
---

<TopPageSection headingSVG={headingEvents} isFullWidth={true}>
    <Slider />
    <div class="link-wrapper">
        <a href={translatePath('/events/')}>
            <Image src={t({ja: linkToEvents, en: linkToEventsEn})} alt={t({ja: "イベント一覧", en: "Events List"})} class="link-img" />
        </a>
    </div>
</TopPageSection>

<style>
    .link-wrapper {
        display: flex;
        justify-content: flex-end;
    }

    .link-img {
        display: block;
        margin: 50px auto 0;
        width: auto;
    }

    /* モバイル用のCSS */
    @media screen and (max-width: 768px) {
        .link-wrapper {
            margin: 0 5%;
        }
        
        .link-img {
            height: 13px;
        }
    }

    /* デスクトップ用のCSS */
    @media screen and (min-width: 769px) {
        .link-wrapper {
            margin: 0 5%;
        }

        .link-img {
            height: 16px;
        }
    }
</style>