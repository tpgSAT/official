---
const { text, link } = Astro.props as Props;

interface Props {
  text?: string;
  link?: string;
}
---

<a href={link} class="popup-banner">
    <p class="text" set:html={text}></p>
    <p class="arrow">→</p>
</a>

<style>
  a {
    text-decoration: none;
  }

  .popup-banner {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: space-between;

    width: min(calc(92% - 24px), 400px);
    padding: 14px 14px 14px 34px;

    background: #ffffff;
    border: 1px solid #000;
    border-radius: 9999px;

    font-family: "Noto Sans JP", sans-serif;
    color: #000;

    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .popup-banner:hover {
    transform: translateX(-50%) translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .text {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.65px;
    line-height: 1.4;
  }

  .arrow {
    margin: 0;
    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #000;
    color: #fff;

    border-radius: 50%;
    font-size: 16px;
    font-weight: 600;

    flex-shrink: 0;
  }

  /* SP調整 */
  @media (max-width: 640px) {
    .popup-banner {
      padding: 12px 12px 12px 22px;
    }

    .text {
      font-size: 13px;
    }

    .arrow {
      width: 35px;
      height: 35px;
      font-size: 16px;
    }
  }
</style>