---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';

import Heading from '@components/Heading.astro';

import { Image } from 'astro:assets';

import Blobs1 from '@assets/generic/contact_blobs_1.png';
import Blobs2 from '@assets/generic/contact_blobs_2.png';

interface Props {
  department?: string;
  email?: string;
}


const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);

const { department="Taki Plaza Gardener", email="contact@tpgd.jp" } = Astro.props;
---

<Heading title={t({ ja: 'お問い合わせ', en: 'Contact' })}>
    <div id="root">
        <h2>{department}</h2>
        <h5>{t({ ja: '住所', en: 'Address' })}</h5>
        <p>〒152-8550<br />東京都目黒区大岡山 2-12-1 Taki Plaza B2F TPG居室</p>
        <h5>{t({ ja: 'メール', en: 'Email' })}</h5>
        <a href={`mailto:${email}`}><p>{email}</p></a>
        <Image src={Blobs1} alt="Blobs1" id="blobs1" />
        <Image src={Blobs2} alt="Blobs2" id="blobs2" />
    </div>
</Heading>


<style>
    #root {
        width: 100%;
        border-radius: 20px;
        border: 1px solid #6FD7E8;
        background-color: white;
        display: flex;
        flex-direction: column;
        font-family: 'Noto Sans JP Variable', sans-serif;
        padding: 10px 0 10px;
        margin: 30px 0 50px;
        position: relative;
    }

    #root h2 {
        font-size: 16px;
        font-weight: 600;
		letter-spacing: 0.4px;
        margin: 5px 15px;
    }

    #root h5 {
        font-size: 14px;
        font-weight: 500;
		letter-spacing: 0.4px;
        margin: 10px 15px 4px;
    }

    #root p {
        font-size: 13px;
        font-weight: 500;
        margin: 0px 15px 5px;
    }

    #blobs1 {
        position: absolute;
        width: 200px;
        height: auto;
        bottom: -40px;
        left: -40px;
        z-index: -1;
    }

    #blobs2 {
        position: absolute;
        width: 200px;
        height: auto;
        top: -50px;
        right: -30px;
        z-index: -1;
    }

</style>
