---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import { Image } from "astro:assets";
import type { Event } from "@lib/events";
interface Props {
    event: Event;
}

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);
const locale = lang === "en" ? "en-US" : "ja-JP";

const { event } = Astro.props as Props;

if (!event.externalUrl && !event.path) {
    throw new Error("EventCard requires either event.path or event.externalUrl");
}

const href = event.externalUrl ?? translatePath(`/events${event.path}`);
const isExternalLink = Boolean(event.externalUrl);
const title = t({ ja: event.title, en: event.titleEn ?? event.title });
const formatDate = (value: string) =>
    new Date(value).toLocaleDateString(locale, {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    });
const dateText =
    event.endDate && event.endDate !== event.date
        ? `${formatDate(event.date)} - ${formatDate(event.endDate)}`
        : formatDate(event.date);
---

<a href={href} target={isExternalLink ? "_blank" : undefined} rel={isExternalLink ? "noopener noreferrer" : undefined}>
    <div class="content">
		<div class="img-wrapper"><Image src={event.thumbnail} class="thumbnail" alt={title} /></div>
        <div class="info">
            <h3 class="title">{title}</h3>
            <div class="meta">
                <p class="date">{dateText}</p>
                {event.time && <p class="time">{event.time}</p>}
            </div>
        </div>
    </div>
</a>


<style>
	a {
        text-decoration: none;
        color: inherit;
    }

	.thumbnail {
		width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 15px;
	}

    .info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .title {
        margin: 0;
        padding: 0;
        font-weight: 500;
    }

    .meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .date,
    .time {
        margin: 0;
        color: #707070;
        letter-spacing: 0.4px;
        font-weight: 400;
    }

    /* モバイル用のCSS */
    @media screen and (max-width: 768px) {
		.content {
			font-family: 'Noto Sans JP Variable', sans-serif;
			padding: 15px 0 0;
			display: grid;
			grid-template-columns: 40% 1fr;
			gap: 0 10px;
            align-items: start;
		}

		.img-wrapper {
			width: 100%;
			aspect-ratio: 16 / 10;
        	overflow: hidden;
        }

        .info {
            grid-column: 2 / 3;
        }

        .title {
            font-size: 14px;
        }

        .date,
        .time {
            font-size: 10px;
        }
    }

    /* デスクトップ用のCSS */
    @media screen and (min-width: 769px) {
		.content {
			font-family: 'Noto Sans JP Variable', sans-serif;
			padding: 15px 0;
			width: 340px;
		}

		.img-wrapper {
			width: 100%;
			aspect-ratio: 16 / 10;
        	overflow: hidden;
		}

        .info {
            margin-top: 10px;
        }

        .title {
            font-size: 14px;
        }

        .date,
        .time {
            font-size: 10px;
        }
    }
</style>
