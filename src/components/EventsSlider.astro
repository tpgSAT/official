---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import { Image } from 'astro:assets';

import { events } from "@lib/events";

// Splideのスタイルをインポート
import '@splidejs/splide/css';

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);
---

<div class="splide" role="group" aria-label="直近のイベント">
  <div class="splide__track">
		<div class="splide__list">
            {events.slice(0, 5).map((event) => (
                <a href={translatePath(`/events${event.path}`)} class="splide__slide">
                    <div class="event-slide-item">
                        <div class="img-wrapper"><Image src={event.thumbnail} class="event_image" alt={event.title} /></div>
                        <p class="event_tag">Taki Plaza B2F</p>
                        <h3 class="event_title">{t({ja: event.title, en: event.titleEn})}</h3>
                        <p class="event_date">{new Date(event.date).toLocaleDateString('ja-JP')}</p>
                    </div>
                </a>
            ))}
		</div>
  </div>
</div>

<style>
    a {
        text-decoration: none;
    }
    
    .splide {
        width: 95vw;
        margin: 0 0 0 5vw;
        margin-top: 20px;
    }

    .img-wrapper {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

    .event_image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 20px;
    }

    .event_tag {
        font-family: 'Noto Sans JP Variable', sans-serif;
        font-weight: 400;
        padding: 4px 6px;
        color: #FFF;
        background-color: #000;
        border-radius: 6px;
        display: inline-block;
        margin: 10px 8px 0;
    }

    .event_title {
        font-family: 'Noto Sans JP Variable', sans-serif;
        font-weight: 500;
        margin: 8px 8px 4px;
    }

    .event_date {
        font-family: 'Noto Sans JP Variable', sans-serif;
    }

    /* モバイル用のCSS */
    @media screen and (max-width: 768px) {
        .event_tag {
            font-size: 10px;
            letter-spacing: 0.4px;
        }

        .event_title {
            font-size: 18px;
        }

        .event_date {
            font-size: 12px;
            margin: 0 22px;
            color: #000;
            position: relative;
        }

        .event_date::before {
            content: "";
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #000;
            position: absolute;
            left: -12px;
            top: 50%;
            transform: translateY(-40%);
        }
    }

    /* デスクトップ用のCSS */
    @media screen and (min-width: 769px) {
        .event-slide-item {
            display: grid;
            grid-template-rows: 80px 1fr 40px;
            grid-template-columns: 1fr 30px 1fr;
        }

        .img-wrapper {
            grid-column: 1 /  2;
            grid-row: 1 / span 3;
        }

        .event_tag {
            grid-column: 3 /  4;
            grid-row: 1 / 2;
            width: max-content;
            height: max-content;
            justify-self: start;
            align-self: end;
            font-size: 12px;
            letter-spacing: 0.5px;
        }

        .event_title {
            grid-column: 3 /  4;
            grid-row: 2 / 3;
            font-size: 28px;
        }

        .event_date {
            grid-column: 3 /  4;
            grid-row: 3 / 4;
            font-size: 15px;
            margin: 0 10px;
            color: #717171;
        }

    }
</style>

<script>
    // SplideのJavaScriptをインポートしてスライダーを初期化
    import Splide from '@splidejs/splide';
    const splide = new Splide( '.splide', {
        type   : 'slide',
        gap    : '20px',
        arrows : false,
        pagination: false,
        fixedWidth: '85vw',
    } );
    splide.mount();
</script>