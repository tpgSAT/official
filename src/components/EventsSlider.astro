---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import { Image } from 'astro:assets';

import { events, type Event } from "@lib/events";

// Splideのスタイルをインポート
import '@splidejs/splide/css';

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);
const locale = lang === "en" ? "en-US" : "ja-JP";

const getEventHref = (event: Event) => {
    if (event.externalUrl) return event.externalUrl;
    if (event.path) return translatePath(`/events${event.path}`);
    throw new Error("EventsSlider requires either event.path or event.externalUrl");
};

const isExternalEvent = (event: Event) => Boolean(event.externalUrl);
const formatDate = (value: string) =>
    new Date(value).toLocaleDateString(locale, {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    });

const getEventDateText = (event: Event) =>
    event.endDate && event.endDate !== event.date
        ? `${formatDate(event.date)} - ${formatDate(event.endDate)}`
        : formatDate(event.date);
---

<div class="splide" role="group" aria-label="直近のイベント">
  <div class="splide__track">
		<div class="splide__list">
            {events.slice(0, 5).map((event) => (
                <a
                    href={getEventHref(event)}
                    class="splide__slide"
                    target={isExternalEvent(event) ? "_blank" : undefined}
                    rel={isExternalEvent(event) ? "noopener noreferrer" : undefined}
                >
                    <div class="event-slide-item">
                        <div class="img-wrapper">
                            <Image
                                src={event.thumbnail}
                                class="event_image"
                                alt={t({ ja: event.title, en: event.titleEn ?? event.title })}
                            />
                        </div>
                        <div class="event_info">
                            <h3 class="event_title">{t({ja: event.title, en: event.titleEn ?? event.title})}</h3>
                            <div class="event_meta">
                                <p class="event_date">{getEventDateText(event)}</p>
                                {event.time && <p class="event_time">{event.time}</p>}
                            </div>
                        </div>
                    </div>
                </a>
            ))}
		</div>
  </div>
</div>

<style>
    a {
        text-decoration: none;
        color: inherit;
    }
    
    .splide {
        width: 95vw;
        margin: 0 0 0 5vw;
        margin-top: 20px;
    }

    .img-wrapper {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

    .event_image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 20px;
    }

    .event_title {
        font-family: 'Noto Sans JP Variable', sans-serif;
        font-weight: 500;
        margin: 0;
    }

    .event_info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin: 10px 8px 0;
    }

    .event_date,
    .event_time {
        font-family: 'Noto Sans JP Variable', sans-serif;
        margin: 0;
        color: #717171;
    }

    .event_meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    /* モバイル用のCSS */
    @media screen and (max-width: 768px) {
        .event_title {
            font-size: 18px;
        }

        .event_date,
        .event_time {
            font-size: 12px;
            margin: 0;
            position: relative;
            padding-left: 14px;
        }

        .event_date::before,
        .event_time::before {
            content: "";
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #000;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-40%);
        }
    }

    /* デスクトップ用のCSS */
    @media screen and (min-width: 769px) {
        .event-slide-item {
            display: grid;
            grid-template-columns: 1fr 30px 1fr;
            align-items: stretch;
        }

        .img-wrapper {
            grid-column: 1 /  2;
            grid-row: 1 / 2;
        }

        .event_info {
            grid-column: 3 /  4;
            grid-row: 1 / 2;
            margin: 0;
            justify-content: center;
        }

        .event_title {
            font-size: 28px;
        }

        .event_date,
        .event_time {
            font-size: 15px;
        }

    }
</style>

<script>
    // SplideのJavaScriptをインポートしてスライダーを初期化
    import Splide from '@splidejs/splide';
    const splide = new Splide( '.splide', {
        type   : 'slide',
        gap    : '20px',
        arrows : false,
        pagination: false,
        fixedWidth: '85vw',
    } );
    splide.mount();
</script>
