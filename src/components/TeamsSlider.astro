---
import { useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

import { Image } from 'astro:assets';
import Event from '@assets/about/thumbnail/event.png';
import Community from '@assets/about/thumbnail/community.png';
import Production from '@assets/about/thumbnail/production.png';
import Management from '@assets/about/thumbnail/management.png';
import System from '@assets/about/thumbnail/system.png';

// Splideのスタイルをインポート
import '@splidejs/splide/css';

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const translatePath = (path: string) => getRelativeLocaleUrl(lang, path);
---

<div class="splide" role="group" aria-label="直近のイベント">
  <div class="splide__track">
		<div class="splide__list">
            <a href={translatePath("/about/event/")} class="splide__slide">
                <div class="team-slide-item">
                    <Image src={Event} class="team-thumbnail" alt="イベント班" />
                    <h3>{t({ ja: 'イベント班', en: 'Event Team' })}</h3>
                </div>
            </a>
            <a href={translatePath('/about/community/')} class="splide__slide">
                <div class="team-slide-item">
                    <Image src={Community} class="team-thumbnail" alt="コミュニティ班" />
                    <h3>{t({ ja: 'コミュニティ班', en: 'Community Team' })}</h3>
                </div>
            </a>
            <a href={translatePath('/about/production/')} class="splide__slide">
                <div class="team-slide-item">
                    <Image src={Production} class="team-thumbnail" alt="制作班" />
                    <h3>{t({ ja: '制作班', en: 'Production Team' })}</h3>
                </div>
            </a>
            <a href={translatePath('/about/management/')} class="splide__slide">
                <div class="team-slide-item">
                    <Image src={Management} class="team-thumbnail" alt="マネジメント班" />
                    <h3>{t({ ja: 'マネジメント班', en: 'Management Team' })}</h3>
                </div>
            </a>
            <a href={translatePath('/about/system/')} class="splide__slide">
                <div class="team-slide-item">
                    <Image src={System} class="team-thumbnail" alt="システム班" />
                    <h3>{t({ ja: 'システム班', en: 'System Team' })}</h3>
                </div>
            </a>
		</div>
  </div>
</div>

<style>
    a {
        text-decoration: none;
    }
    
    .splide {
        width: 95vw;
        margin: 0;
        margin-top: 20px;
    }

    .team-thumbnail {
        width: 100%;
        height: auto;
        border-radius: 20px;
    }

    .team-slide-item h3 {
        font-family: 'Noto Sans JP Variable', sans-serif;
        font-weight: 500;
        font-size: 14px;
        margin: 4px 8px 4px;
    }
</style>

<script>
    // SplideのJavaScriptをインポートしてスライダーを初期化
    import Splide from '@splidejs/splide';
    const splide = new Splide( '.splide', {
        type   : 'slide',
        gap    : '20px',
        arrows : false,
        pagination: false,
        fixedWidth: '20vw',
        flickMaxPages: 1,
        flickPower: 200,
        rewind: true,
        rewindByDrag: true,
        breakpoints: {
            768: {
                fixedWidth: '65vw',
                rewind: false,
                rewindByDrag: true,
            },
        }
    } );
    splide.mount();
</script>