{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@layouts/*": [
				"src/layouts/*"
			],
			"@components/*": [
				"src/components/*"
			],
			"@lib/*": [
				"src/lib/*"
			],
			"@assets/*": [
				"src/assets/*"
			],
			"@i18n/*": [
				"src/i18n/*"
			]
		}
	}
}